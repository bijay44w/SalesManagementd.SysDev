        </Grid>

        <!-- ======================================================== -->
        <!-- Modal Overlay: Account Info & Password Change Dialog     -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_UserProfile" Grid.RowSpan="2" Visibility="Collapsed" Panel.ZIndex="1000">
            <!-- Semi-transparent backdrop -->
            <Border Background="#66000000" MouseLeftButtonDown="modal_Backdrop_MouseLeftButtonDown" />

            <!-- Centered Modal Card -->
            <Border Width="470"
                    Background="#FFFFFF"
                    CornerRadius="16"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    Padding="32,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.15" BlurRadius="30" ShadowDepth="8" Direction="270" />
                </Border.Effect>

                <StackPanel>
                    <!-- Modal Header -->
                    <Grid Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                <Path Fill="#1976D2" Width="20" Height="20" Stretch="Uniform"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="アカウント情報・パスワード変更" FontSize="17" FontWeight="Bold" Foreground="#1E293B" />
                                <TextBlock Text="現在の登録情報とパスワード設定" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button x:Name="btn_CloseProfileModal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="32" Height="32"
                                Background="#F1F5F9"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btn_CloseProfileModal_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Employee Info Details Box -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- ID -->
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="社員ID" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                <TextBlock x:Name="modal_txt_EmpId" Text="1002" FontSize="15" FontWeight="Bold" Foreground="#1E293B" />
                            </StackPanel>

                            <!-- Name -->
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="氏名" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
