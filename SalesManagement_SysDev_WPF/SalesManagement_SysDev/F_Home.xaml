                            <TextBlock Text="電話番号 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="reg_txt_ClPhone" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="13" />
                        </StackPanel>
                    </Grid>

                    <!-- 住所 -->
                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Text="住所 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="reg_txt_ClAddress" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="50" />
