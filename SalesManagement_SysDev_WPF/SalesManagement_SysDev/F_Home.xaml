                            <Border Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                <Path Fill="#1976D2" Width="20" Height="20" Stretch="Uniform"
                                      Data="M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="3.5 顧客非表示（フラグ）" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                                <TextBlock Text="選択された項目の顧客管理フラグを0から2に更新します。" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseClientHide_Click">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- Alert Banners -->
                    <Border x:Name="border_HideErrorAlert" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_HideErrorMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="border_HideSuccessAlert" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_HideSuccessMessage" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- Selection by ID -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="対象顧客ID:" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox x:Name="hide_txt_ClId" Grid.Column="1" Height="32" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#CBD5E1" Margin="0,0,10,0" KeyUp="hide_txt_ClId_KeyUp" />
                            <Button Grid.Column="2" Content="情報確認" Height="32" Padding="14,0" Background="#1976D2" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand" Click="btn_LoadClientForHide_Click" />
                        </Grid>
                    </Border>

                    <!-- Customer Info Details -->
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="顧客名:" FontSize="12" Foreground="#64748B" Width="80" HorizontalAlignment="Left" />
                                <TextBlock x:Name="hide_txt_DisplayClName" Text="-" FontSize="13" FontWeight="Bold" Foreground="#1E293B" Margin="80,0,0,0" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="所属営業所:" FontSize="12" Foreground="#64748B" Width="80" HorizontalAlignment="Left" />
                                <TextBlock x:Name="hide_txt_DisplayOffice" Text="-" FontSize="12.5" Foreground="#334155" Margin="80,0,0,0" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="現在のフラグ:" FontSize="12" Foreground="#64748B" Width="80" HorizontalAlignment="Left" />
                                <TextBlock x:Name="hide_txt_DisplayFlag" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#1976D2" Margin="80,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Reason -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="非表示理由 (任意)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="hide_txt_Reason" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" />
                    </StackPanel>

                    <!-- Submit / Action Button -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="キャンセル" Height="40" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand" Click="btn_CloseClientHide_Click" />
                        <Button Grid.Column="1" Content="フラグを 2 に更新" Height="40" Background="#DC2626" Foreground="#FFFFFF" FontWeight="Bold" Margin="6,0,0,0" Cursor="Hand" Click="btn_ExecuteClientHide_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
