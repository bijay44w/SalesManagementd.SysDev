                                <TextBlock Text="役職" FontSize="11" Foreground="#64748B" Margin="0,0,0,2" />
                                <TextBlock x:Name="modal_txt_Position" Text="営業" FontSize="13" FontWeight="SemiBold" Foreground="#334155" />
                            </StackPanel>
                        </Grid>
