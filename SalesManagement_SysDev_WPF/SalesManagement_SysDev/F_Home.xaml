                            <Button Grid.Column="2" Content="情報取得" Height="32" Padding="14,0" Background="#1976D2" Foreground="#FFFFFF" FontWeight="SemiBold" Cursor="Hand" Click="btn_LoadClientForUpdate_Click" />
