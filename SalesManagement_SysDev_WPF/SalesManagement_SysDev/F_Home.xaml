<Window x:Class="SalesManagement_SysDev.F_Home"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="販売管理システム"
        Height="700" Width="1040"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontFamily="Segoe UI, Meiryo, 'Yu Gothic UI', sans-serif"
        Background="#FFFFFF">

    <!-- Enable custom title bar & window resizing -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="54"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window Control Button Style (Minimize, Maximize) -->
        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter Property="Foreground" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Window Close Button Style -->
        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Width" Value="48" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#C4101E" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style (Normal) -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2563EB" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation Button Style (Active / Selected) -->
        <Style x:Key="SidebarActiveButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarButtonStyle}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#2563EB" CornerRadius="8" Padding="14,0">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Action Card Style -->
        <Style x:Key="ActionCardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BorderBrush" Value="#E2E8F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="20" ShadowDepth="4" Direction="270" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#93C5FD" />
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#2563EB" Opacity="0.12" BlurRadius="22" ShadowDepth="6" Direction="270" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Circular Action Arrow Button Style -->
        <Style x:Key="CircleArrowButtonStyle" TargetType="Border">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Background" Value="#EFF6FF" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Application Layout Grid -->
        <Grid.RowDefinitions>
            <!-- Top Title Bar -->
            <RowDefinition Height="54" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- Top Title Bar (White Background with Subtle Divider)     -->
        <!-- ======================================================== -->

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <!-- Left: App Identity (Blue Logo Box + Title) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <!-- ハンバーガーボタン -->

                    <!-- Rounded Blue App Icon Badge -->
                    
                    <!-- ハンバーガーボタン -->
                    <Button x:Name="btn_ToggleSidebar"
                        Content="☰"
                        Width="50"
                        Height="50"
                        FontSize="24"
                        Background="Transparent"
                        Foreground="#2563EB"
                        BorderThickness="0"
                        Cursor="Hand"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True"
                        Click="btn_ToggleSidebar_Click"/>   

                    <shell:TextBlock Text="販売管理システム" FontSize="17.5" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" />

                </StackPanel>

                <!-- Hidden Employee Display elements to keep code-behind functional -->
                <TextBlock x:Name="txt_UserDisplay" Visibility="Collapsed" />
                <TextBlock x:Name="txt_Welcome" Visibility="Collapsed" />
                <TextBlock x:Name="txt_UserDetail" Visibility="Collapsed" />

                <!-- Right: User Avatar + Position Dropdown + Window Chrome Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- User Profile Dropdown Pill -->
                    <Border x:Name="border_UserPill"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            Cursor="Hand"
                            Padding="6,4,12,4"
                            CornerRadius="20"
                            Background="Transparent"
                            ToolTip="アカウント確認・パスワード変更"
                            MouseLeftButtonUp="border_UserPill_MouseLeftButtonUp">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Circular Blue Avatar -->
                            <Border Width="30" Height="30" CornerRadius="15" Background="#2563EB" Margin="0,0,8,0">
                                <Path Fill="#FFFFFF" Width="15" Height="15" Stretch="Uniform"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                            </Border>

                            <!-- Role Title (default: 管理者) -->
                            <TextBlock x:Name="txt_UserRoleDisplay" Text="管理者" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" VerticalAlignment="Center" Margin="0,0,6,0" />

                            <!-- Down Chevron Arrow -->
                            <Path Fill="#64748B" Width="10" Height="6" Stretch="Uniform" VerticalAlignment="Center"
                                  Data="M7 10l5 5 5-5z" />
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Separator Width="1" Height="24" Background="#E2E8F0" Margin="4,0,8,0" />

                    <!-- Window Chrome Controls (Minimize, Maximize, Close) -->
                    <!-- Minimize Button -->
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="btn_Minimize_Click" ToolTip="最小化">
                        <Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" Width="10" Height="2" Stretch="Fill" Data="M0,0 L10,0" />
                    </Button>

                    <!-- Maximize / Restore Button -->
                    <Button Style="{StaticResource WindowControlButtonStyle}" Click="btn_Maximize_Click" ToolTip="最大化">
                        <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" Width="10" Height="10" Stretch="Fill" Data="M0,0 H10 V10 H0 Z" />
                    </Button>

                    <!-- Close Button -->
                    <Button Style="{StaticResource WindowCloseButtonStyle}" Click="btn_Close_Click" ToolTip="閉じる">
                        <Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                              StrokeThickness="1.5" Width="10" Height="10" Stretch="Fill" Data="M0,0 L10,10 M10,0 L0,10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- Main Body (Sidebar + Content Canvas)                     -->
        <!-- ======================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Sidebar -->
                <ColumnDefinition x:Name="SidebarColumn" Width="200" />
                <!-- Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================================================== -->
            <!-- Left Navigation Sidebar                              -->
            <!-- ==================================================== -->
            <Grid Grid.Column="0">
                <!-- Rich Blue Gradient Background -->
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#184DAA" Offset="0" />
                        <GradientStop Color="#103B8D" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <!-- Sidebar Content Container -->
                <Grid Margin="12,16,12,20">

                    <!-- Top Navigation List -->
                    <StackPanel VerticalAlignment="Top">

                        <!-- 0. メインメニュー -->
                        <Button x:Name="btn_NavMainMenu"
                                Style="{StaticResource SidebarActiveButtonStyle}"
                                Click="MenuButton_Click"
                                Tag="00">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#FFFFFF"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
                                <TextBlock Text="メインメニュー"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- 1. 顧客管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                             Click="MenuButton_Click"
                             Tag="03">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#FFFFFF"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                     Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" 
                                />
                                <TextBlock Text="顧客管理"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" 
                               />
                            </StackPanel>
                        </Button>

                        <!-- 商品管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                                 Click="MenuButton_Click"
                                 Tag="04">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#FFFFFF"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      Data="M20 8l-8-4-8 4v8l8 4 8-4V8z M4 8l8 4 8-4 M12 12v8" />
                                <TextBlock Text="商品管理"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>


                        <!-- 在庫管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                                Click="MenuButton_Click"
                                Tag="05">
                            <StackPanel Orientation="Horizontal">
                                <Path Fill="#FFFFFF"
                                      Width="18"
                                      Height="18"
                                      Stretch="Uniform"
                                      Margin="0,0,12,0"
                                      Data="M3 3h18v18H3z M3 9h18 M9 3v18" />
                                <TextBlock Text="在庫管理"
                                      FontSize="14"
                                      FontWeight="SemiBold"
                                      VerticalAlignment="Center"
                                 />
                            </StackPanel>
                        </Button>



                        <!-- 06. 社員管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="06">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="06" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="社員管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 07. 売上管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="07">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="07" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="売上管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 08. 受注管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="08">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="08" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="受注管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 09. 注文管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="09">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="09" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="注文管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 10. 発注管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="10" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="発注管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 11. 入庫管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="11">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="11" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="入庫管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 12. 出庫管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="12">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="12" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="出庫管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 13. 入荷管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="13">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="13" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="入荷管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- 14. 出荷管理 -->
                        <Button Style="{StaticResource SidebarButtonStyle}"
                Click="MenuButton_Click"
                Tag="14">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="14" Width="30" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="出荷管理" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </Grid>

                <!-- Bottom: ログアウト -->
                <Button x:Name="btn_Logout" Style="{StaticResource SidebarButtonStyle}" VerticalAlignment="Bottom" Click="btn_Logout_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Fill="#E2E8F0" Width="18" Height="18" Stretch="Uniform" Margin="0,0,12,0"
                                  Data="M17 7l-1.41 1.41L18.17 11H8v2h10.17l-2.58 2.58L17 17l5-5zM4 5h8V3H4c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h8v-2H4V5z" />
                        <TextBlock Text="ログアウト" FontSize="13.5" FontWeight="Normal" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ==================================================== -->
            <!-- Main Content Area                                    -->
            <!-- ==================================================== -->
            <Grid Grid.Column="1">
                <!-- Soft Ambient Background Gradient -->
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#F4F8FD" Offset="0" />
                        <GradientStop Color="#ECF2FB" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>

                <Grid x:Name="CustomerContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <!-- Section Header Area -->
                        <RowDefinition Height="Auto" />
                        <!-- Action Cards Grid -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Section Header -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="36,30,36,18">
                        <!-- Header Icon Badge (Circle) -->
                        <Border Background="#DBEAFE" Width="54" Height="54" CornerRadius="27" Margin="0,0,16,0">
                            <Path Fill="#2563EB" Width="26" Height="26" Stretch="Uniform"
                                  Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z" />
                        </Border>

                        <!-- Header Titles -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="顧客管理" FontSize="25" FontWeight="Bold" Foreground="#0F172A" />
                            <TextBlock Text="顧客の情報を管理し、スムーズな取引をサポートします。" FontSize="13" Foreground="#64748B" Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 3x2 Action Cards Grid (5 Cards matching screenshot layout) -->
                    <Grid Grid.Row="1" Margin="26,0,36,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ============================================ -->
                        <!-- Card 1: 顧客登録 (Row 0, Col 0)             -->
                        <!-- ============================================ -->
                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionCardBorderStyle}"
                                MouseLeftButtonUp="card_ClientRegister_MouseLeftButtonUp" Margin="8,8,8,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <!-- Circular Icon Badge -->
                                    <Border Background="#EFF6FF" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <Path Fill="#2563EB" Width="20" Height="20" Stretch="Uniform"
                                              Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />
                                    </Border>
                                    <TextBlock Text="顧客登録" FontSize="17.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                    <TextBlock Text="新しい顧客の情報を入力し、&#x0a;登録します。" FontSize="12" Foreground="#64748B" LineHeight="19" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Bottom Right Action Circle Arrow Button -->
                                <Border Style="{StaticResource CircleArrowButtonStyle}" RenderTransformOrigin="-1.37,0.173">
                                    <Path Fill="#2563EB" Width="13" Height="13" Stretch="Uniform"
                                          Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ============================================ -->
                        <!-- Card 2: 顧客更新 (Row 0, Col 1)             -->
                        <!-- ============================================ -->
                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ActionCardBorderStyle}"
                                MouseLeftButtonUp="card_ClientUpdate_MouseLeftButtonUp" Margin="8,8,8,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <!-- Circular Icon Badge -->
                                    <Border Background="#EFF6FF" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <Path Fill="#2563EB" Width="20" Height="20" Stretch="Uniform"
                                              Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
                                    </Border>
                                    <TextBlock Text="顧客更新" FontSize="17.5" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,8" />
                                    <TextBlock Text="既存の顧客情報を検索し、&#x0a;内容を編集・更新します。" FontSize="12" Foreground="#64748B" LineHeight="19" TextWrapping="Wrap" />
                                </StackPanel>

                                <!-- Bottom Right Action Circle Arrow Button -->
                                <Border Style="{StaticResource CircleArrowButtonStyle}">
                                    <Path Fill="#2563EB" Width="13" Height="13" Stretch="Uniform"
                                          Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- ============================================ -->
                        <!-- Card 3: 顧客一覧表示 (Row 0, Col 2)         -->
                        <!-- ============================================ -->
                        <Border Grid.Row="0" shell:Grid.Column="2" Style="{StaticResource ActionCardBorderStyle}"
                                MouseLeftButtonUp="card_ClientList_MouseLeftButtonUp" Margin="8,8,8,8">
                            <Grid>
                                <StackPanel VerticalAlignment="Top">
                                    <!-- Circular Icon Badge -->
                                    <Border Background="#EFF6FF" Width="44" Height="44" CornerRadius="22" HorizontalAlignment="Left" Margin="0,0,0,14">
                                        <Path Fill="#2563EB" Width="20" Height="20" Stretch="Uniform"
