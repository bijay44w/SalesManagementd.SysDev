                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                            <TextBlock Text="所属営業所 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <ComboBox x:Name="reg_cmb_SalesOffice" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="SoName" SelectedValuePath="SoId" />
