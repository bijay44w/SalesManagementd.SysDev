                        <TextBlock Text="住所 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="upd_txt_ClAddress" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="50" />
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
