                    </StackPanel>

                    <!-- Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="キャンセル" Height="40" Background="#F1F5F9" Foreground="#334155" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand" Click="btn_CloseClientRegister_Click" />
                        <Button Grid.Column="1" Content="顧客を登録する" Height="40" Background="#1976D2" Foreground="#FFFFFF" FontWeight="Bold" Margin="6,0,0,0" Cursor="Hand" Click="btn_ExecuteClientRegister_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

