                                <Path Fill="#1976D2" Width="20" Height="20" Stretch="Uniform"
                                      Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4zm7.25-1.71l-1.54-1.54c-.2-.2-.51-.2-.71 0l-1.25 1.25 2.25 2.25 1.25-1.25c.2-.2.2-.51 0-.71zM14.5 14.5l-4.5 4.5V21h2l4.5-4.5-2-2z" />
