<UserControl x:Class="SalesManagement_SysDev.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#008080"
             FontFamily="MS UI Gothic, Meiryo, Yu Gothic UI"
             FontSize="12">

    <UserControl.Resources>
        <!-- Classic WinForms Button Style -->
        <Style x:Key="ClassicWinFormsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="6,5"/>
            <Setter Property="Padding" Value="14,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5F1FB"/>
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CCE4F7"/>
                                <Setter Property="BorderBrush" Value="#005499"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Big Retro Operation Button Style (業務ボタン) -->
        <Style x:Key="RetroBigButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="80"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Background="#008080" MinWidth="820" MinHeight="580">
            <Grid.RowDefinitions>
                <!-- Header Banner -->
                <RowDefinition Height="Auto"/>
                <!-- Main Body -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Area: Simple Title + User Status -->
            <Grid Grid.Row="0" Margin="24,20,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <TextBlock Grid.Column="0"
                           Text="販売管理システム"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>

                <!-- Right: Simple User Status Info (White text on teal) -->
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22"/>
                        <RowDefinition Height="22"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="ログオンユーザー :" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock x:Name="lbl_User" Grid.Row="0" Grid.Column="1" Text="管理者" FontWeight="Bold" Foreground="#FFFFFF"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="所属店舗 :" Foreground="#FFFFFF" Margin="14,0,6,0"/>
                    <TextBlock x:Name="lbl_Store" Grid.Row="0" Grid.Column="3" Text="本社営業所" Foreground="#FFFFFF"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="権限 :" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                    <TextBlock x:Name="lbl_Role" Grid.Row="1" Grid.Column="1" Text="管理者" Foreground="#FFFFFF"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="ログオン日時 :" Foreground="#FFFFFF" Margin="14,0,6,0"/>
                    <TextBlock x:Name="lbl_LogonDate" Grid.Row="1" Grid.Column="3" Text="2026/10/23 15:00" Foreground="#FFFFFF"/>
                </Grid>
            </Grid>

            <!-- 2. Simple Retro Main Content (業務 + 設定) -->
            <StackPanel Grid.Row="1" Margin="24,0,24,24">

                <!-- 業務 GroupBox -->
                <GroupBox Background="#D4D0C8"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1"
                          Margin="0,0,0,16">
                    <GroupBox.Header>
                        <TextBlock Text=" 業務 " FontWeight="Bold" Foreground="#000000" FontSize="13"/>
                    </GroupBox.Header>

                    <!-- Cream Inner Panel -->
                    <Border Background="#FFFDE7"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Padding="16,14"
                            Margin="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 売上管理 (Soft Blue) -->
                            <Button Grid.Column="0"
                                    Style="{StaticResource RetroBigButtonStyle}"
                                    Background="#BAC8FE"
                                    BorderBrush="#8F9EE5"
                                    Click="btn_Sales_Click">
                                <TextBlock Text="売上管理" FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                            </Button>

                            <!-- 在庫管理 (Soft Pink) -->
                            <Button Grid.Column="2"
                                    Style="{StaticResource RetroBigButtonStyle}"
                                    Background="#FFC2C2"
                                    BorderBrush="#E59898"
                                    Click="btn_Inventory_Click">
                                <TextBlock Text="在庫管理" FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                            </Button>

                            <!-- 発注管理 (Soft Mint Green) -->
                            <Button Grid.Column="4"
                                    Style="{StaticResource RetroBigButtonStyle}"
                                    Background="#C2F5C5"
                                    BorderBrush="#98DE9C"
                                    Click="btn_PurchaseOrder_Click">
                                <TextBlock Text="発注管理" FontSize="20" FontWeight="Bold" Foreground="#000000"/>
                            </Button>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- 設定 GroupBox -->
                <GroupBox Background="#D4D0C8"
                          BorderBrush="#E0E0E0"
                          BorderThickness="1">
                    <GroupBox.Header>
                        <TextBlock Text=" 設定 " FontWeight="Bold" Foreground="#000000" FontSize="13"/>
                    </GroupBox.Header>

                    <!-- Cream Inner Panel -->
                    <Border Background="#FFFDE7"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Padding="18,16"
                            Margin="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Row 0: 主要マスタ設定 -->
                            <Button Grid.Row="0" Grid.Column="0" Content="商品マスター管理"
                                    FontWeight="Bold"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_Product_Click"/>

                            <Button Grid.Row="0" Grid.Column="1" Content="商品メーカマスター管理"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_Product_Click"/>

                            <Button Grid.Row="0" Grid.Column="2" Content="商品カテゴリマスター管理"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_Product_Click"/>

                            <Button Grid.Row="0" Grid.Column="3" Content="消費税マスター管理"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_TaxMaster_Click"/>

                            <!-- Row 1: 組織・取引先マスタ設定 -->
                            <Button Grid.Row="1" Grid.Column="0" Content="スタッフマスター管理"
                                    FontWeight="Bold"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_Employee_Click"/>

                            <Button Grid.Row="1" Grid.Column="1" Content="部署・役職マスター管理"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_DivisionMaster_Click"/>

                            <Button Grid.Row="1" Grid.Column="2" Content="店舗マスター管理"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_StoreMaster_Click"/>

                            <Button Grid.Row="1" Grid.Column="3" Content="顧客・取引先マスター管理"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Click="btn_Customer_Click"/>
                        </Grid>
                    </Border>
                </GroupBox>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
