<UserControl x:Class="SalesManagement_SysDev.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#008080"
             FontFamily="MS UI Gothic, Meiryo, Yu Gothic UI, Segoe UI"
             FontSize="12">

    <UserControl.Resources>
        <!-- Classic WinForms Setting Button Style -->
        <Style x:Key="ClassicSettingButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#7F9DB9"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5F1FB"/>
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CCE4F7"/>
                                <Setter Property="BorderBrush" Value="#005499"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top MenuBar Button Style -->
        <Style x:Key="TopMenuItemButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A3B9C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0A2475"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <Grid Background="#008080" MinWidth="880">
            <Grid.RowDefinitions>
                <!-- Top Navy Menu Bar -->
                <RowDefinition Height="30"/>
                <!-- Header Banner -->
                <RowDefinition Height="Auto"/>
                <!-- Main Body (業務 + 設定) -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Top Navy Menu Bar -->
            <Grid Grid.Row="0" Background="#000080">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left Menu Items -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Content="売上管理" Style="{StaticResource TopMenuItemButtonStyle}" Click="btn_Sales_Click"/>
                    <Button Content="在庫管理" Style="{StaticResource TopMenuItemButtonStyle}" Click="btn_Inventory_Click"/>
                    <Button Content="発注管理" Style="{StaticResource TopMenuItemButtonStyle}" Click="btn_PurchaseOrder_Click"/>
                    <Button Content="商品管理" Style="{StaticResource TopMenuItemButtonStyle}" Click="btn_Product_Click"/>
                    <Button Content="従業員管理" Style="{StaticResource TopMenuItemButtonStyle}" Click="btn_Employee_Click"/>
                    <Button Content="店舗・取引先管理" Style="{StaticResource TopMenuItemButtonStyle}" Click="btn_Customer_Click"/>
                    <Button Content="終了" Style="{StaticResource TopMenuItemButtonStyle}" FontWeight="Bold" Click="btn_Exit_Click"/>
                </StackPanel>

                <!-- Right Search & Logon Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBox x:Name="txt_QuickSearch"
                             Width="110"
                             Height="20"
                             Padding="4,1"
                             VerticalContentAlignment="Center"
                             Background="#FFFFFF"
                             Foreground="#666666"
                             Text="ここへ入力"
                             GotFocus="txt_QuickSearch_GotFocus"
                             LostFocus="txt_QuickSearch_LostFocus"
                             Margin="0,0,10,0"
                             BorderBrush="#7F9DB9"
                             BorderThickness="1"/>

                    <Button Content="ログオン"
                            Width="74"
                            Height="24"
                            Background="#FFFFFF"
                            Foreground="#000000"
                            BorderBrush="#000000"
                            BorderThickness="1"
                            FontWeight="Bold"
                            FontSize="11.5"
                            Cursor="Hand"
                            Click="btn_LogonStatus_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. Header Area (Title and School / User Info) -->
            <Grid Grid.Row="1" Margin="20,14,20,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Title (Left) -->
                <TextBlock Grid.Column="0"
                           Text="販売管理システム"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           VerticalAlignment="Center"/>

                <!-- School Info & Logged-In User Details (Right) -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="大阪情報コンピュータ専門学校"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Right"
                               Margin="0,0,0,6"/>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <!-- Row 0: ログオンユーザー & 所属店舗 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ログオンユーザー :" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                        <TextBlock x:Name="lbl_User" Grid.Row="0" Grid.Column="1" Text="管理者" FontWeight="Bold" Foreground="#FFFFFF"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="所属店舗 :" Foreground="#FFFFFF" Margin="14,0,6,0"/>
                        <TextBlock x:Name="lbl_Store" Grid.Row="0" Grid.Column="3" Text="本社営業所" Foreground="#FFFFFF"/>

                        <!-- Row 1: 権限 & ログオン日時 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="権限 :" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                        <TextBlock x:Name="lbl_Role" Grid.Row="1" Grid.Column="1" Text="管理者" Foreground="#FFFFFF"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ログオン日時 :" Foreground="#FFFFFF" Margin="14,0,6,0"/>
                        <TextBlock x:Name="lbl_LogonDate" Grid.Row="1" Grid.Column="3" Text="2026/10/23 14:00" Foreground="#FFFFFF"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- 3. Body Content Area -->
            <StackPanel Grid.Row="2" Margin="18,0,18,18">

                <!-- Group 1: 業務 (Daily Operations) -->
                <GroupBox Margin="0,0,0,14"
                          Background="#D4D0C8"
                          BorderBrush="#FFFFFF"
                          BorderThickness="1">
                    <GroupBox.Header>
                        <TextBlock Text=" 業務 " FontWeight="Bold" Foreground="#000000" FontSize="12.5"/>
                    </GroupBox.Header>

                    <!-- Cream Inner Panel -->
                    <Border Background="#FFFDE7"
                            BorderBrush="#A0A0A0"
                            BorderThickness="1"
                            Padding="16,14"
                            Margin="4,4,4,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 1. 売上管理 (Soft Blue/Purple) -->
                            <Button Grid.Column="0"
                                    Height="76"
                                    Background="#BAC8FE"
                                    BorderBrush="#8A9AD6"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="btn_Sales_Click">
                                <TextBlock Text="売上管理"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#000000"/>
                            </Button>

                            <!-- 2. 在庫管理 (Soft Pink) -->
                            <Button Grid.Column="2"
                                    Height="76"
                                    Background="#FFC2C2"
                                    BorderBrush="#D99898"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="btn_Inventory_Click">
                                <TextBlock Text="在庫管理"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#000000"/>
                            </Button>

                            <!-- 3. 発注管理 (Soft Mint Green) -->
                            <Button Grid.Column="4"
                                    Height="76"
                                    Background="#C2F5C5"
                                    BorderBrush="#95CF98"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    Click="btn_PurchaseOrder_Click">
                                <TextBlock Text="発注管理"
                                           FontSize="21"
                                           FontWeight="Bold"
                                           Foreground="#000000"/>
                            </Button>
                        </Grid>
                    </Border>
                </GroupBox>

                <!-- Group 2: 設定 (Master Data Settings) -->
                <GroupBox Background="#D4D0C8"
                          BorderBrush="#FFFFFF"
                          BorderThickness="1">
                    <GroupBox.Header>
                        <TextBlock Text=" 設定 " FontWeight="Bold" Foreground="#000000" FontSize="12.5"/>
                    </GroupBox.Header>

                    <StackPanel Margin="4,4,4,4">

                        <!-- Sub-Section 1: 商品管理 -->
                        <TextBlock Text="商品管理" FontWeight="Bold" Margin="4,2,0,2"/>
                        <Border Background="#FFFDE7"
                                BorderBrush="#A0A0A0"
                                BorderThickness="1"
                                Padding="12,10"
                                Margin="0,0,0,10">
                            <UniformGrid Rows="1" Columns="4">
                                <Button Content="商品メーカマスター管理"
                                        Style="{StaticResource ClassicSettingButtonStyle}"
                                        Click="btn_Product_Click"/>
                                <Button Content="商品カテゴリマスター管理"
                                        Style="{StaticResource ClassicSettingButtonStyle}"
                                        Click="btn_Product_Click"/>
                                <Button Content="商品マスター管理"
                                        Style="{StaticResource ClassicSettingButtonStyle}"
                                        FontWeight="Bold"
                                        Click="btn_Product_Click"/>
                                <Button Content="消費税マスター管理"
                                        Style="{StaticResource ClassicSettingButtonStyle}"
                                        Click="btn_TaxMaster_Click"/>
                            </UniformGrid>
                        </Border>

                        <!-- Sub-Section 2: 仕入先管理 & 店舗マスター管理 (2 Columns) -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 仕入先管理 (Left) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="仕入先管理" FontWeight="Bold" Margin="4,0,0,2"/>
                                <Border Background="#FFFDE7"
                                        BorderBrush="#A0A0A0"
                                        BorderThickness="1"
                                        Padding="12,10">
                                    <Button Content="仕入先マスター管理"
                                            Width="160"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource ClassicSettingButtonStyle}"
                                            Click="btn_SupplierMaster_Click"/>
                                </Border>
                            </StackPanel>

                            <!-- 店舗マスター管理 (Right) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="店舗マスター管理" FontWeight="Bold" Margin="4,0,0,2"/>
                                <Border Background="#FFFDE7"
                                        BorderBrush="#A0A0A0"
                                        BorderThickness="1"
                                        Padding="12,10">
                                    <Button Content="店舗マスター管理"
                                            HorizontalAlignment="Left"
                                            Width="140"
                                            Style="{StaticResource ClassicSettingButtonStyle}"
                                            Click="btn_StoreMaster_Click"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Sub-Section 3: 従業員管理 & 取引先マスター管理 (2 Columns) -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 従業員管理 (Left) -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="従業員管理" FontWeight="Bold" Margin="4,0,0,2"/>
                                <Border Background="#FFFDE7"
                                        BorderBrush="#A0A0A0"
                                        BorderThickness="1"
                                        Padding="12,10">
                                    <UniformGrid Rows="1" Columns="3">
                                        <Button Content="スタッフマスター管理"
                                                Style="{StaticResource ClassicSettingButtonStyle}"
                                                FontWeight="Bold"
                                                Click="btn_Employee_Click"/>
                                        <Button Content="部署マスター管理"
                                                Style="{StaticResource ClassicSettingButtonStyle}"
                                                Click="btn_DivisionMaster_Click"/>
                                        <Button Content="役職マスター管理"
                                                Style="{StaticResource ClassicSettingButtonStyle}"
                                                Click="btn_PositionMaster_Click"/>
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- 取引先マスター管理 (Right) -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="取引先マスター管理" FontWeight="Bold" Margin="4,0,0,2"/>
                                <Border Background="#FFFDE7"
                                        BorderBrush="#A0A0A0"
                                        BorderThickness="1"
                                        Padding="12,10">
                                    <Button Content="タスク管理"
                                            HorizontalAlignment="Left"
                                            Width="140"
                                            Style="{StaticResource ClassicSettingButtonStyle}"
                                            Click="btn_Customer_Click"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
