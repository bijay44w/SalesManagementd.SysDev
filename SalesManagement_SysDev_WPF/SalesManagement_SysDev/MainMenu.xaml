<UserControl x:Class="SalesManagement_SysDev.MainMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#008080"
             FontFamily="MS UI Gothic, Meiryo, Yu Gothic UI"
             FontSize="12">

    <UserControl.Resources>
        <!-- Classic WinForms Button Style -->
        <Style x:Key="ClassicWinFormsButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#707070"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="4,4"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5F1FB"/>
                                <Setter Property="BorderBrush" Value="#0078D7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#CCE4F7"/>
                                <Setter Property="BorderBrush" Value="#005499"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Guide Tab Button Style -->
        <Style x:Key="GuideTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <!-- Root Grid with Overlay Support -->
    <Grid Background="#008080">
        <!-- Main Scrollable Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Background="#008080" MinWidth="850" MinHeight="600">
                <Grid.RowDefinitions>
                    <!-- Header Banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Info Notice Banner -->
                    <RowDefinition Height="Auto"/>
                    <!-- Main Body: 全体メモ & 個人メモ -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ======================================================== -->
                <!-- 1. Header Area: Title + Guide Button + User Status       -->
                <!-- ======================================================== -->
                <Grid Grid.Row="0" Margin="24,18,24,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Title & Quick Guide Trigger -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="販売管理システム"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   VerticalAlignment="Center"
                                   Margin="0,0,20,0"/>

                        <!-- 使い方 (システムの使い方) ボタン -->
                        <Button x:Name="btn_OpenHelpGuide"
                                Style="{StaticResource ClassicWinFormsButtonStyle}"
                                Height="36"
                                Background="#FFFEEA"
                                BorderBrush="#D4A72C"
                                BorderThickness="1.5"
                                Padding="14,4"
                                Click="btn_OpenHelpGuide_Click"
                                ToolTip="システムの全体概要、操作方法、業務フローを閲覧します">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="システムの使い方 (操作ガイド)" FontSize="13" FontWeight="Bold" Foreground="#8A5A00" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right: User Status Info (White text on teal) -->
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ログオンユーザー :" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                        <TextBlock x:Name="lbl_User" Grid.Row="0" Grid.Column="1" Text="管理者" FontWeight="Bold" Foreground="#FFFFFF"/>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="所属店舗 :" Foreground="#FFFFFF" Margin="14,0,6,0"/>
                        <TextBlock x:Name="lbl_Store" Grid.Row="0" Grid.Column="3" Text="本社営業所" Foreground="#FFFFFF"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="権限 :" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                        <TextBlock x:Name="lbl_Role" Grid.Row="1" Grid.Column="1" Text="管理者" Foreground="#FFFFFF"/>

                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ログオン日時 :" Foreground="#FFFFFF" Margin="14,0,6,0"/>
                        <TextBlock x:Name="lbl_LogonDate" Grid.Row="1" Grid.Column="3" Text="2026/10/27 15:55" Foreground="#FFFFFF"/>
                    </Grid>
                </Grid>

                <!-- ======================================================== -->
                <!-- 2. Guide Info Strip Banner                              -->
                <!-- ======================================================== -->
                <Border Grid.Row="1" Margin="24,0,24,12" Background="#E0F2FE" BorderBrush="#7DD3FC" BorderThickness="1" Padding="14,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="左側のサイドメニューから各業務（顧客・商品・在庫・売上等）を選択できます。操作方法の確認は右上の「システムの使い方」をご利用ください。"
                                       FontSize="12" Foreground="#0369A1" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="社内ポータル" FontSize="11" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- ======================================================== -->
                <!-- 3. Main Content: 全体メモ & 個人メモ                     -->
                <!-- ======================================================== -->
                <Grid Grid.Row="2" Margin="24,0,24,24">
                    <GroupBox Background="#D4D0C8"
                              BorderBrush="#E0E0E0"
                              BorderThickness="1">
                        <GroupBox.Header>
                            <TextBlock Text=" 社内連絡事項（全体メモ） ＆ 社員専用 個人メモ " FontWeight="Bold" Foreground="#000000" FontSize="13"/>
                        </GroupBox.Header>

                        <Border Background="#FFFDE7"
                                BorderBrush="#A0A0A0"
                                BorderThickness="1"
                                Padding="14"
                                Margin="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <!-- Left: 全体メモ (52%) -->
                                    <ColumnDefinition Width="1.1*"/>
                                    <!-- Separator (14px) -->
                                    <ColumnDefinition Width="14"/>
                                    <!-- Right: 個人メモ (48%) -->
                                    <ColumnDefinition Width="0.9*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ==================================================== -->
                                <!-- [左側] 全体メモ (管理者などの連絡事項共有)           -->
                                <!-- ==================================================== -->
                                <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#C0C0C0" BorderThickness="1" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header of Shared Memos -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📢" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="全体メモ（社内連絡事項）" FontSize="14" FontWeight="Bold" Foreground="#1E3A8A" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lbl_SharedMemoAdminBadge"
                                                           Text=" [管理者のみ投稿可] "
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 管理者用 新規連絡登録ボタン -->
                                            <Button x:Name="btn_NewSharedMemo"
                                                    Grid.Column="1"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                                    Height="30"
                                                    Margin="0"
                                                    Padding="10,2"
                                                    Background="#E8F5E9"
                                                    BorderBrush="#4CAF50"
                                                    Click="btn_NewSharedMemo_Click"
                                                    ToolTip="新しい社内連絡事項を登録します（管理者権限）">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="＋" FontWeight="Bold" Foreground="#2E7D32" Margin="0,0,4,0"/>
                                                    <TextBlock Text="新規連絡を投稿" FontSize="12" FontWeight="Bold" Foreground="#2E7D32"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Filter Bar: アクセス区分絞り込み -->
                                        <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" Padding="8,4" Margin="0,0,0,8">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="表示絞り込み :" FontSize="11" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <RadioButton x:Name="rdo_FilterAll" Content="すべて" IsChecked="True" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <RadioButton x:Name="rdo_FilterGeneral" Content="一般連絡" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <RadioButton x:Name="rdo_FilterAdmin" Content="管理者限定" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                    <RadioButton x:Name="rdo_FilterConfidential" Content="機密情報" FontSize="11" VerticalAlignment="Center"/>
                                                </StackPanel>

                                                <TextBlock x:Name="lbl_SharedMemoCount"
                                                           HorizontalAlignment="Right"
                                                           Text="0 件"
                                                           FontSize="11"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <!-- List of Shared Memos (広々とした高さ) -->
                                        <ListBox x:Name="lst_SharedMemos"
                                                 Grid.Row="2"
                                                 MinHeight="300"
                                                 Background="#F8FAFC"
                                                 BorderBrush="#CBD5E1"
                                                 BorderThickness="1"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 MouseDoubleClick="lst_SharedMemos_MouseDoubleClick">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8" Margin="0,1">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <!-- AccessLevel Badge (一般 / 管理者限定 / 機密) -->
                                                            <Border Grid.Row="0" Grid.Column="0"
                                                                    Background="{Binding AccessLevelBackground}"
                                                                    CornerRadius="3"
                                                                    Padding="6,2"
                                                                    Margin="0,0,4,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding AccessLevelName}"
                                                                           FontSize="10.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Priority Badge (重要 / 連絡 / 周知) -->
                                                            <Border Grid.Row="0" Grid.Column="1"
                                                                    Background="{Binding PriorityBackground}"
                                                                    CornerRadius="3"
                                                                    Padding="5,2"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Priority}"
                                                                           FontSize="10.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="#FFFFFF"/>
                                                            </Border>

                                                            <!-- Title -->
                                                            <TextBlock Grid.Row="0" Grid.Column="2"
                                                                       Text="{Binding Title}"
                                                                       FontSize="12.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#0F172A"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>

                                                            <!-- Date -->
                                                            <TextBlock Grid.Row="0" Grid.Column="3"
                                                                       Text="{Binding DisplayDate}"
                                                                       FontSize="11"
                                                                       Foreground="#64748B"
                                                                       VerticalAlignment="Center"
                                                                       Margin="6,0,0,0"/>

                                                            <!-- Content Summary & Author -->
                                                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,6,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Summary}"
                                                                           FontSize="11.5"
                                                                           Foreground="#475569"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding AuthorName, StringFormat='発信: {0}'}"
                                                                           FontSize="11"
                                                                           Foreground="#94A3B8"
                                                                           Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Footer Action of Shared Memos -->
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <TextBlock Text="※ 一般連絡は誰でも閲覧可、管理者限定は管理者のみ、機密情報は認証が必要です"
                                                       FontSize="11"
                                                       Foreground="#64748B"
                                                       VerticalAlignment="Center"/>

                                            <Button x:Name="btn_ViewSharedMemoDetail"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                                    Height="30"
                                                    Margin="0"
                                                    Padding="14,2"
                                                    Click="btn_ViewSharedMemoDetail_Click">
                                                <TextBlock Text="詳細を表示" FontSize="12"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- ==================================================== -->
                                <!-- [右側] 個人メモ (ログイン社員専用の個人メモ)         -->
                                <!-- ==================================================== -->
                                <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#C0C0C0" BorderThickness="1" Padding="14,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header of Personal Memo -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📝" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lbl_PersonalMemoHeader"
                                                           Text="個人メモ（自分専用）"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#0F766E"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Controls: New & Delete -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="btn_NewPersonalMemo"
                                                        Style="{StaticResource ClassicWinFormsButtonStyle}"
                                                        Height="28"
                                                        Margin="0,0,4,0"
                                                        Padding="8,1"
                                                        Click="btn_NewPersonalMemo_Click"
                                                        ToolTip="新しい個人メモを作成します">
                                                    <TextBlock Text="＋ 新規" FontSize="11.5"/>
                                                </Button>
                                                <Button x:Name="btn_DeletePersonalMemo"
                                                        Style="{StaticResource ClassicWinFormsButtonStyle}"
                                                        Height="28"
                                                        Margin="0"
                                                        Padding="8,1"
                                                        Click="btn_DeletePersonalMemo_Click"
                                                        ToolTip="選択中の個人メモを削除します">
                                                    <TextBlock Text="🗑 削除" FontSize="11.5"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Memo Selector & Title Input -->
                                        <Grid Grid.Row="1" Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Memo List Dropdown -->
                                            <ComboBox x:Name="cmb_PersonalMemos"
                                                      Grid.Column="0"
                                                      Height="28"
                                                      DisplayMemberPath="DisplayTitle"
                                                      SelectedValuePath="Id"
                                                      SelectionChanged="cmb_PersonalMemos_SelectionChanged"
                                                      ToolTip="保存されている個人メモを切り替えます"/>

                                            <!-- Memo Title TextBox -->
                                            <TextBox x:Name="txt_PersonalMemoTitle"
                                                     Grid.Column="2"
                                                     Height="28"
                                                     Padding="6,4"
                                                     FontSize="12.5"
                                                     VerticalContentAlignment="Center"
                                                     ToolTip="メモのタイトル"/>
                                        </Grid>

                                        <!-- Memo Content TextBox (広々としたノートエディタ) -->
                                        <TextBox x:Name="txt_PersonalMemoContent"
                                                 Grid.Row="2"
                                                 MinHeight="295"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 Padding="8"
                                                 FontSize="12.5"
                                                 FontFamily="Meiryo, Yu Gothic UI"
                                                 BorderBrush="#CBD5E1"
                                                 BorderThickness="1"
                                                 ToolTip="メモの内容を入力してください"/>

                                        <!-- Footer Status & Save Button -->
                                        <Grid Grid.Row="3" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock x:Name="lbl_PersonalMemoStatus"
                                                           Text="最終更新: -"
                                                           FontSize="11.5"
                                                           Foreground="#64748B"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock x:Name="lbl_PersonalMemoSavedMessage"
                                                           Text=" ✓ 保存しました"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="#2E7D32"
                                                           Visibility="Collapsed"
                                                           VerticalAlignment="Center"
                                                           Margin="8,0,0,0"/>
                                            </StackPanel>

                                            <Button x:Name="btn_SavePersonalMemo"
                                                    HorizontalAlignment="Right"
                                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                                    Height="30"
                                                    Margin="0"
                                                    Padding="16,2"
                                                    Background="#E0F2FE"
                                                    BorderBrush="#0284C7"
                                                    Click="btn_SavePersonalMemo_Click"
                                                    ToolTip="入力中の個人メモを保存します">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="💾" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="メモを保存" FontWeight="Bold" Foreground="#0369A1" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </GroupBox>
                </Grid>

            </Grid>
        </ScrollViewer>

        <!-- ============================================================ -->
        <!-- モーダル 1: システムの使い方 (操作説明ガイド・閲覧用)        -->
        <!-- ============================================================ -->
        <Grid x:Name="modal_HelpGuide" Visibility="Collapsed" Panel.ZIndex="1000">
            <!-- Backdrop -->
            <Border Background="#80000000" MouseLeftButtonDown="modal_HelpGuide_Backdrop_Click"/>

            <!-- Main Modal Window -->
            <Border Width="840" Height="560"
                    Background="#FFFFFF"
                    BorderBrush="#707070"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="25" ShadowDepth="6" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Modal Title Bar -->
                        <RowDefinition Height="46"/>
                        <!-- Tabs & Content -->
                        <RowDefinition Height="*"/>
                        <!-- Bottom Bar -->
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar -->
                    <Border Grid.Row="0" Background="#004D40" Padding="16,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📖" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="販売管理システム 操作ガイド・取扱説明書（閲覧用）"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Close Button (✕) -->
                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="30" Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="btn_CloseHelpGuide_Click">
                                <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Tabbed Manual Content -->
                    <TabControl Grid.Row="1" Margin="8,8,8,4" Background="#FFFFFF" BorderBrush="#CBD5E1">

                        <!-- Tab 1: 全体概要 & 機能一覧 -->
                        <TabItem Header=" 🔰 システム全体概要 " Style="{StaticResource GuideTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                                <StackPanel>
                                    <Border Background="#E0F2FE" BorderBrush="#0284C7" BorderThickness="1,0,0,0" Padding="12,8" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="本システム（販売管理システム）の目的" FontWeight="Bold" FontSize="14" Foreground="#0369A1" Margin="0,0,0,4"/>
                                            <TextBlock Text="商品の受注・発注から在庫管理、入出荷、売上計上までの業務を一元管理し、正確かつ迅速な販売管理を実現します。" FontSize="12.5" LineHeight="20" Foreground="#334155" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="■ 主要モジュール一覧と機能説明" FontWeight="Bold" FontSize="13.5" Margin="0,4,0,8" Foreground="#0F172A"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- 1 -->
                                        <Border Grid.Row="0" Grid.Column="0" Background="#F1F5F9" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1">
                                            <TextBlock Text="売上管理 (07)" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <Border Grid.Row="0" Grid.Column="1" Background="#FFFFFF" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,1,1,1">
                                            <TextBlock Text="出荷完了した注文の売上確定および売上履歴の照会・検索を行います。" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 2 -->
                                        <Border Grid.Row="1" Grid.Column="0" Background="#F1F5F9" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                                            <TextBlock Text="在庫管理 (05)" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <Border Grid.Row="1" Grid.Column="1" Background="#FFFFFF" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="現在の各商品在庫数を確認し、安全在庫数の監視や手動在庫調整を行います。" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 3 -->
                                        <Border Grid.Row="2" Grid.Column="0" Background="#F1F5F9" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                                            <TextBlock Text="発注管理 (10)" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <Border Grid.Row="2" Grid.Column="1" Background="#FFFFFF" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="仕入先メーカに対する発注データの作成・承認・確定処理を行います。" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 4 -->
                                        <Border Grid.Row="3" Grid.Column="0" Background="#F1F5F9" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                                            <TextBlock Text="受注 / 注文管理" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <Border Grid.Row="3" Grid.Column="1" Background="#FFFFFF" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="顧客からの注文受領（受注）、および出荷に向けた注文確定処理を管理します。" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 5 -->
                                        <Border Grid.Row="4" Grid.Column="0" Background="#F1F5F9" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                                            <TextBlock Text="入出庫・入荷出荷" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <Border Grid.Row="4" Grid.Column="1" Background="#FFFFFF" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="入荷・入庫検品による在庫増加、および出庫・出荷作業による商品払出を行います。" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 6 -->
                                        <Border Grid.Row="5" Grid.Column="0" Background="#F1F5F9" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                                            <TextBlock Text="商品マスター (04)" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <Border Grid.Row="5" Grid.Column="1" Background="#FFFFFF" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="取扱商品の登録・価格設定・カテゴリ・メーカ情報の維持管理を行います。" TextWrapping="Wrap"/>
                                        </Border>

                                        <!-- 7 -->
                                        <Border Grid.Row="6" Grid.Column="0" Background="#F1F5F9" Padding="8,6" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1">
                                            <TextBlock Text="顧客マスター (03)" FontWeight="Bold" Foreground="#1E3A8A"/>
                                        </Border>
                                        <Border Grid.Row="6" Grid.Column="1" Background="#FFFFFF" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,0,1,1">
                                            <TextBlock Text="取引先顧客の情報（住所、電話番号、担当営業所等）の登録・照会を行います。" TextWrapping="Wrap"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 2: 業務フロー -->
                        <TabItem Header=" 🔄 標準業務フロー " Style="{StaticResource GuideTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                                <StackPanel>
                                    <!-- Flow 1: 販売業務 -->
                                    <Border Background="#F0FDF4" BorderBrush="#22C55E" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="◆ 販売・出荷業務フロー（顧客からの注文〜売上計上）" FontWeight="Bold" FontSize="13.5" Foreground="#15803D" Margin="0,0,0,8"/>
                                            <TextBlock Text="① 受注管理 (08) : 顧客からの注文内容を入力し、受注データを登録します。" Margin="0,2" Foreground="#334155"/>
                                            <TextBlock Text="② 注文管理 (09) : 受注内容を確認・確定し、出荷手配（注文確定）を行います。" Margin="0,2" Foreground="#334155"/>
                                            <TextBlock Text="③ 出庫管理 (12) : 倉庫へピッキング指示を出し、出庫対象商品を準備します。" Margin="0,2" Foreground="#334155"/>
                                            <TextBlock Text="④ 出荷管理 (14) : 梱包および配送手配を完了し、出荷確定を行います（在庫が減少）。" Margin="0,2" Foreground="#334155"/>
                                            <TextBlock Text="⑤ 売上管理 (07) : 出荷完了データに基づき売上を確定計上します。" FontWeight="SemiBold" Margin="0,2" Foreground="#0F172A"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Flow 2: 仕入業務 -->
                                    <Border Background="#EFF6FF" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="◆ 仕入・入荷業務フロー（商品発注〜在庫反映）" FontWeight="Bold" FontSize="13.5" Foreground="#1D4ED8" Margin="0,0,0,8"/>
                                            <TextBlock Text="① 発注管理 (10) : 在庫減少に伴い、仕入先メーカへ発注データを登録・発行します。" Margin="0,2" Foreground="#334155"/>
                                            <TextBlock Text="② 入荷管理 (13) : メーカから届いた納品物を受領し、入荷検品を行います。" Margin="0,2" Foreground="#334155"/>
                                            <TextBlock Text="③ 入庫管理 (11) : 検品完了商品を倉庫の正規棚へ格納し、入庫確定を行います。" Margin="0,2" Foreground="#334155"/>
                                            <TextBlock Text="④ 在庫管理 (05) : 入庫確定により現在庫数が自動的に加算・反映されます。" FontWeight="SemiBold" Margin="0,2" Foreground="#0F172A"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 3: 基本操作ルール & 連絡区分 -->
                        <TabItem Header=" 💡 基本操作・セキュリティ区分 " Style="{StaticResource GuideTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                                <StackPanel>
                                    <!-- 連絡事項のアクセス区分 -->
                                    <Border Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="■ 社内連絡事項（全体メモ）のセキュリティ区分" FontWeight="Bold" FontSize="13.5" Foreground="#B45309" Margin="0,0,0,6"/>
                                            <TextBlock Text="社内連絡事項には3つのアクセス区分が設定されており、情報セキュリティを確保しています：" FontSize="12" Margin="0,0,0,6"/>
                                            
                                            <TextBlock Text="① 一般的な業務連絡 (青バッジ) : 全社員がログイン後、そのまま自由に閲覧できます。" Margin="0,2" FontWeight="SemiBold" Foreground="#1E3A8A"/>
                                            <TextBlock Text="② 管理者向けの重要な連絡 (橙バッジ) : 管理者権限を持つアカウントのみ閲覧可能です（一般社員には非表示/アクセス不可）。" Margin="0,2" FontWeight="SemiBold" Foreground="#B45309"/>
                                            <TextBlock Text="③ 機密情報を含む連絡 (紫バッジ) : 閲覧時に追加の暗証パスコード（初期設定: 9999）の入力が必要です。" Margin="0,2" FontWeight="SemiBold" Foreground="#6B21A8"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- 検索 -->
                                    <TextBlock Text="1. 検索・一覧表示の操作" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Text="・各画面の検索欄にキーワード（ID、氏名、商品名、電話番号等）を入力して「検索」を実行すると絞り込みが可能です。&#x0a;・条件を空にして検索ボタンを押すと、全件の一覧が表示されます。&#x0a;・非表示（論理削除）されたデータは通常一覧には表示されません（「非表示を含む」チェックで確認可能）。"
                                               LineHeight="20" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <!-- 登録・更新 -->
                                    <TextBlock Text="2. データの新規登録・更新手順" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Text="・必須項目（名前、価格、営業所、パスワードなど）は漏れなく入力してください。&#x0a;・重複するIDや電話番号の不正入力時はバリデーションエラーが表示されます。&#x0a;・登録・更新処理後はメッセージボックスが表示され、一覧が自動更新されます。"
                                               LineHeight="20" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                    <!-- メモ機能 -->
                                    <TextBlock Text="3. 個人メモ機能の活用" FontWeight="Bold" FontSize="13.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                    <TextBlock Text="・ログイン中の社員本人だけが閲覧・編集できる専用メモです。日々のToDoや顧客との会話メモ等にご活用ください。"
                                               LineHeight="20" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Tab 4: FAQ & 注意点 -->
                        <TabItem Header=" ❓ よくある質問・注意点 " Style="{StaticResource GuideTabItemStyle}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                                <StackPanel>
                                    <!-- Q1 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Q. 機密情報のパスコードは何ですか？" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                            <TextBlock Text="A. 初期設定の閲覧用パスコードは「9999」です。管理者が連絡事項を投稿・編集する際に、任意のパスコードに変更することも可能です。" LineHeight="19" Foreground="#475569" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Q2 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Q. 一般社員アカウントで管理者限定の連絡を見ることはできますか？" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                            <TextBlock Text="A. 見ることはできません。情報統制のため、管理者限定の連絡は管理者権限（管理者役職）でログインしている場合のみ閲覧できます。" LineHeight="19" Foreground="#475569" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Q3 -->
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="Q. パスワードの変更はどこから行えますか？" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" Margin="0,0,0,4"/>
                                            <TextBlock Text="A. 画面右上の社員名（役職ピル）をクリックすると「アカウント情報・パスワード変更」モーダルが表示されます。現在のパスワードと新しいパスワード（4〜10文字）を入力して変更してください。" LineHeight="19" Foreground="#475569" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>

                    <!-- Bottom Bar -->
                    <Border Grid.Row="2" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource ClassicWinFormsButtonStyle}"
                                Width="100"
                                Height="30"
                                Content="閉じる"
                                Click="btn_CloseHelpGuide_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- モーダル 2: 全体メモ 詳細・新規登録・編集ダイアログ          -->
        <!-- ============================================================ -->
        <Grid x:Name="modal_SharedMemoDetail" Visibility="Collapsed" Panel.ZIndex="1001">
            <!-- Backdrop -->
            <Border Background="#80000000" MouseLeftButtonDown="modal_SharedMemoDetail_Backdrop_Click"/>

            <!-- Main Modal Window -->
            <Border Width="640"
                    Background="#FFFFFF"
                    BorderBrush="#707070"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.35" BlurRadius="25" ShadowDepth="6" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="46"/>
                        <!-- Form / Detail Content -->
                        <RowDefinition Height="*"/>
                        <!-- Footer -->
                        <RowDefinition Height="52"/>
                    </Grid.RowDefinitions>

                    <!-- Title Bar -->
                    <Border Grid.Row="0" Background="#1E3A8A" Padding="16,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📢" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="modal_SharedMemoTitleText"
                                           Text="全体メモ（社内連絡事項）詳細"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Foreground="#FFFFFF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="30" Height="30"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Click="btn_CloseSharedMemoModal_Click">
                                <TextBlock Text="✕" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Form Content -->
                    <StackPanel Grid.Row="1" Margin="20,16,20,12">
                        <!-- Row 1: Priority & Date Grid -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="重要度 :" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmb_SharedMemoPriority"
                                      Grid.Column="1"
                                      Height="28"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="重要"/>
                                <ComboBoxItem Content="連絡"/>
                                <ComboBoxItem Content="周知"/>
                                <ComboBoxItem Content="通常"/>
                            </ComboBox>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="lbl_SharedMemoMeta" Text="投稿者: 管理者 ｜ 2026/10/27 15:55" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Access Level (公開区分) & Passcode -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="アクセス区分 :" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="cmb_SharedMemoAccessLevel"
                                      Grid.Column="1"
                                      Height="28"
                                      VerticalContentAlignment="Center"
                                      SelectionChanged="cmb_SharedMemoAccessLevel_SelectionChanged">
                                <ComboBoxItem Content="一般連絡 (全社員閲覧可)" Tag="General"/>
                                <ComboBoxItem Content="管理者限定 (管理者のみ)" Tag="AdminOnly"/>
                                <ComboBoxItem Content="機密情報 (要パスコード認証)" Tag="Confidential"/>
                            </ComboBox>

                            <!-- 機密情報のパスコード設定入力 -->
                            <TextBlock x:Name="lbl_SharedMemoPasscodeLabel"
                                       Grid.Column="2"
                                       Text="認証コード:"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Margin="12,0,6,0"
                                       Visibility="Collapsed"/>
                            <TextBox x:Name="txt_SharedMemoPasscode"
                                     Grid.Column="3"
                                     Height="28"
                                     MaxLength="10"
                                     VerticalContentAlignment="Center"
                                     Padding="6,2"
                                     ToolTip="機密情報の閲覧に必要なパスコード（例: 9999）"
                                     Visibility="Collapsed"/>
                        </Grid>

                        <!-- Title Input -->
                        <TextBlock Text="タイトル :" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txt_SharedMemoTitle"
                                 Height="30"
                                 FontSize="13"
                                 Padding="6,4"
                                 Margin="0,0,0,10"
                                 BorderBrush="#CBD5E1"/>

                        <!-- Content Input -->
                        <TextBlock Text="本文 / 連絡内容 :" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBox x:Name="txt_SharedMemoContent"
                                 Height="170"
                                 FontSize="12.5"
                                 FontFamily="Meiryo, Yu Gothic UI"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8"
                                 BorderBrush="#CBD5E1"/>

                        <!-- Non-admin Notice -->
                        <TextBlock x:Name="lbl_SharedMemoReadOnlyNotice"
                                   Text="※ 一般社員アカウントは閲覧専用です。連絡の投稿・編集は管理者のみ可能です。"
                                   FontSize="11"
                                   Foreground="#D97706"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Footer Bar -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
                        <Grid VerticalAlignment="Center">
                            <!-- Left: Delete Button (Admin only) -->
                            <Button x:Name="btn_DeleteSharedMemo"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Height="30"
                                    Padding="12,2"
                                    Background="#FEE2E2"
                                    BorderBrush="#EF4444"
                                    Click="btn_DeleteSharedMemo_Click">
                                <TextBlock Text="この連絡を削除" Foreground="#B91C1C" FontWeight="Bold"/>
                            </Button>

                            <!-- Right: Save & Close Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="btn_SaveSharedMemo"
                                        Style="{StaticResource ClassicWinFormsButtonStyle}"
                                        Height="30"
                                        Padding="16,2"
                                        Margin="0,0,8,0"
                                        Background="#E0F2FE"
                                        BorderBrush="#0284C7"
                                        Click="btn_SaveSharedMemo_Click">
                                    <TextBlock Text="保存する" Foreground="#0369A1" FontWeight="Bold"/>
                                </Button>
                                <Button Style="{StaticResource ClassicWinFormsButtonStyle}"
                                        Height="30"
                                        Width="80"
                                        Content="閉じる"
                                        Click="btn_CloseSharedMemoModal_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================ -->
        <!-- モーダル 3: 機密情報アクセス認証ダイアログ                   -->
        <!-- ============================================================ -->
        <Grid x:Name="modal_ConfidentialAuth" Visibility="Collapsed" Panel.ZIndex="1002">
            <!-- Backdrop -->
            <Border Background="#80000000" MouseLeftButtonDown="modal_ConfidentialAuth_Backdrop_Click"/>

            <!-- Centered Auth Card -->
            <Border Width="440" Height="260"
                    Background="#FFFFFF"
                    BorderBrush="#7C3AED"
                    BorderThickness="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.4" BlurRadius="30" ShadowDepth="8" Direction="270"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Header -->
                        <RowDefinition Height="46"/>
                        <!-- Body -->
                        <RowDefinition Height="*"/>
                        <!-- Footer -->
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#6D28D9" Padding="16,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔐" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="機密情報アクセス認証" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Body Content -->
                    <StackPanel Grid.Row="1" Margin="24,14,24,10" VerticalAlignment="Center">
                        <TextBlock Text="この連絡事項には機密情報が含まれています。"
                                   FontWeight="Bold" FontSize="13" Foreground="#1E293B" Margin="0,0,0,4"/>
                        <TextBlock Text="閲覧するには指定のアクセスコード（パスコード）を入力してください。"
                                   FontSize="11.5" Foreground="#64748B" Margin="0,0,0,12"/>

                        <!-- Passcode Input -->
                        <PasswordBox x:Name="pwd_ConfidentialInput"
                                     Height="32"
                                     FontSize="16"
                                     HorizontalContentAlignment="Center"
                                     BorderBrush="#CBD5E1"
                                     KeyDown="pwd_ConfidentialInput_KeyDown"/>

                        <!-- Error Message -->
                        <TextBlock x:Name="lbl_ConfidentialAuthError"
                                   Text="認証コードが一致しません。再度入力してください。"
                                   Foreground="#DC2626"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Margin="0,6,0,0"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Footer Bar -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Height="30"
                                    Width="80"
                                    Content="キャンセル"
                                    Margin="0,0,8,0"
                                    Click="btn_CancelConfidentialAuth_Click"/>
                            <Button Style="{StaticResource ClassicWinFormsButtonStyle}"
                                    Height="30"
                                    Padding="14,2"
                                    Background="#EDE9FE"
