<UserControl x:Class="SalesManagement_SysDev.Receiving"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RetroTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ModalLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 0. ヘッダー：Customer.xamlと同じ構成 -->
        <Border Grid.Row="0" Background="#004D40" Padding="20,12"
                BorderBrush="#00332C" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26A69A" Width="34" Height="34"
                            CornerRadius="4" Margin="0,0,12,0">
                        <TextBlock Text="📦" FontSize="18" Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="入庫管理" FontSize="18"
                                   FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="入庫情報の検索・一覧・登録・更新・非表示管理"
                                   FontSize="11" Foreground="#80CBC4"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="【直接検索 / 即時反映】"
                           FontSize="12" Foreground="#E0F2F1"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
            </Grid>
        </Border>

        <!-- 1. 検索条件 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1"
                BorderThickness="1" CornerRadius="6"
                Margin="16,12,16,8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <WrapPanel Grid.Row="0" VerticalAlignment="Center"
                           Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4"
                                VerticalAlignment="Center">
                        <TextBlock Text="入庫ID:" FontWeight="SemiBold"
                                   Foreground="#334155" VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchWaId"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Width="80" 
                                 TextChanged="txt_SearchWaId_TextChanged" />

                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4"
                                VerticalAlignment="Center">
                        <TextBlock Text="発注ID:" FontWeight="SemiBold"
                                   Foreground="#334155" VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchHaId"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Width="80" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4"
                                VerticalAlignment="Center">
                        <TextBlock Text="商品名:" FontWeight="SemiBold"
                                   Foreground="#334155" VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchProductName"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Width="150" />
                    </StackPanel>
                    <CheckBox x:Name="chk_IncludeHidden" Content="非表示を含む"
                              VerticalAlignment="Center" Margin="6,4,16,4"
                              Foreground="#334155" FontWeight="SemiBold" Checked="chk_IncludeHidden_Checked" />
                </WrapPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btn_Search"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#006666" Foreground="White"
                            Margin="0,0,8,0" Click="btn_Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0"/>
                            <TextBlock Text="検索" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_Clear"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#F1F5F9" Foreground="#334155"
                            BorderBrush="#94A3B8" BorderThickness="1"
                            Click="btn_Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,4,0"/>
                            <TextBlock Text="条件クリア"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
                            Background="#EFF6FF"
                            CornerRadius="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

        <!-- 2. 操作ツールバー -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btn_NewRegister"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#008080" Foreground="White"
                        Margin="0,0,8,0" Click="btn_NewRegister_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,4,0" FontWeight="Bold"/>
                        <TextBlock Text="新規入庫登録" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btn_EditSelected"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#0284C7" Foreground="White"
                        Margin="0,0,8,0" Click="btn_EditSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,4,0"/>
                        <TextBlock Text="選択項目を編集" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btn_HideSelected"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#DC2626" Foreground="White"
                        Margin="0,0,8,0" Click="btn_HideSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" Margin="0,0,4,0"/>
                        <TextBlock Text="非表示設定" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock x:Name="txt_RecordCount" Grid.Column="1"
                       Text="表示件数: 0 件" FontSize="13"
                       Foreground="#475569" FontWeight="SemiBold"
                       HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- 3. 入庫一覧 -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1"
                BorderThickness="1" CornerRadius="6" Margin="16,0,16,16">
            <DataGrid x:Name="dg_Warehousings" AutoGenerateColumns="False"
                      IsReadOnly="True" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0" RowHeight="34"
                      AlternatingRowBackground="#F8FAFC" BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E2E8F0"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="入庫ID"
                                        Binding="{Binding WaId}" Width="75"/>
                    <DataGridTextColumn Header="発注ID"
                                        Binding="{Binding HaId}" Width="75"/>
                    <DataGridTextColumn Header="入庫日"
                                        Binding="{Binding WaDate, StringFormat=yyyy/MM/dd}"
                                        Width="105"/>
                    <DataGridTextColumn Header="担当社員"
                                        Binding="{Binding EmployeeName}" Width="120"/>
                    <DataGridTextColumn Header="商品ID"
                                        Binding="{Binding PrId}" Width="75"/>
                    <DataGridTextColumn Header="商品名"
                                        Binding="{Binding ProductName}" Width="*"/>
                    <DataGridTextColumn Header="入庫数量"
                                        Binding="{Binding WaQuantity}" Width="90"/>
                    <DataGridTextColumn Header="状態"
                                        Binding="{Binding FlagDisplay}" Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 登録・編集モーダル -->
        <Grid x:Name="modal_Editor" Grid.RowSpan="4"
              Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000"
                    MouseLeftButtonDown="modal_Editor_Backdrop_Click"/>
            <Border Width="520" MaxHeight="650" Background="White"
                    CornerRadius="10" BorderBrush="#94A3B8"
                    BorderThickness="1" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2"
                                      BlurRadius="20" ShadowDepth="6"
                                      Direction="270"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="txt_EditorTitle" Text="入庫登録"
                                   FontSize="18" FontWeight="Bold"
                                   Foreground="#004D40" Margin="0,0,0,16"/>
                        <TextBlock Text="発注ID *"
                                   Style="{StaticResource ModalLabelStyle}"/>
                        <ComboBox x:Name="cmb_HaId" Height="30"
                                  Margin="0,0,0,10"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="HaId"
                                  SelectionChanged="cmb_HaId_SelectionChanged"/>
                        <TextBlock Text="担当社員"
                                   Style="{StaticResource ModalLabelStyle}"/>
                        <ComboBox x:Name="cmb_Employee" Height="30"
                                  Margin="0,0,0,10"
                                  DisplayMemberPath="EmName"
                                  SelectedValuePath="EmId"/>
                        <TextBlock Text="入庫日 *"
                                   Style="{StaticResource ModalLabelStyle}"/>
                        <DatePicker x:Name="dp_WaDate" Height="30"
                                    Margin="0,0,0,10"/>
                        <TextBlock Text="商品 *（選択した発注に含まれる商品）"
                                   Style="{StaticResource ModalLabelStyle}"/>
                        <ComboBox x:Name="cmb_Product" Height="30"
                                  Margin="0,0,0,10"
                                  DisplayMemberPath="DisplayText"
                                  SelectedValuePath="PrId"/>
                        <TextBlock Text="入庫数量 *"
                                   Style="{StaticResource ModalLabelStyle}"/>
                        <TextBox x:Name="txt_WaQuantity"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Margin="0,0,0,16"/>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActionButtonStyle}"
                                    Content="キャンセル" Background="#F1F5F9"
                                    Foreground="#334155" BorderBrush="#94A3B8"
                                    BorderThickness="1" Margin="0,0,8,0"
                                    Click="btn_CancelEditor_Click"/>
                            <Button x:Name="btn_ExecuteEditor"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Content="登録実行" Background="#006666"
                                    Foreground="White"
                                    Click="btn_ExecuteEditor_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 非表示モーダル -->
        <Grid x:Name="modal_Hide" Grid.RowSpan="4"
              Visibility="Collapsed" Panel.ZIndex="1100">
            <Border Background="#66000000"
                    MouseLeftButtonDown="modal_Hide_Backdrop_Click"/>
            <Border Width="450" Background="White" CornerRadius="10"
                    BorderBrush="#94A3B8" BorderThickness="1" Padding="24"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.2"
                                      BlurRadius="20" ShadowDepth="6"
                                      Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="入庫非表示設定（論理削除）"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#DC2626" Margin="0,0,0,12"/>
                    <TextBlock x:Name="hide_txt_TargetInfo"
                               Text="入庫ID: -" FontSize="14"
                               Foreground="#1E293B" Margin="0,0,0,12"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="非表示理由"
                               Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox x:Name="hide_txt_Reason"
                             Style="{StaticResource RetroTextBoxStyle}"
                             Margin="0,0,0,16"/>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Content="キャンセル" Background="#F1F5F9"
                                Foreground="#334155" BorderBrush="#94A3B8"
                                BorderThickness="1" Margin="0,0,8,0"
                                Click="btn_CancelHide_Click"/>
                        <Button Style="{StaticResource ActionButtonStyle}"
                                Content="非表示に設定" Background="#DC2626"
                                Foreground="White"
                                Click="btn_ExecuteHide_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>