<UserControl x:Class="SalesManagement_SysDev.Arrival"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RetroTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Modal button styles -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#006666" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: タイトル -->
            <RowDefinition Height="Auto" />
            <!-- 1: 検索条件バー -->
            <RowDefinition Height="Auto" />
            <!-- 2: 操作ツールバー -->
            <RowDefinition Height="Auto" />
            <!-- 3: 一覧表 DataGrid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. タイトルバー                                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#004D40" Padding="20,12" BorderBrush="#00332C" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26A69A" Width="34" Height="34" CornerRadius="4" Margin="0,0,12,0">
                        <TextBlock Text="🚚" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="入荷管理" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="入荷情報の検索・一覧・登録・更新・非表示管理" FontSize="11" Foreground="#80CBC4" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="【直接検索 / 即時反映】" FontSize="12" Foreground="#E0F2F1" VerticalAlignment="Center" Margin="0,0,10,0" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 1. 検索バー                                              -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,12,16,8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- 入荷ID -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="入荷ID:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchArId" Style="{StaticResource RetroTextBoxStyle}" Width="70" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 商品ID -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="商品ID:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchPrId" Style="{StaticResource RetroTextBoxStyle}" Width="70" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 商品名 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="商品名:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchPrName" Style="{StaticResource RetroTextBoxStyle}" Width="130" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- メーカー/仕入先 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="メーカー/仕入先:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="cmb_SearchMaker" Width="130" Height="30" VerticalContentAlignment="Center" DisplayMemberPath="MaName" SelectedValuePath="MaId" />
                    </StackPanel>

                    <!-- 入荷日 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="入荷日:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker x:Name="dp_SearchDateFrom" Height="30" Width="120" />
                        <TextBlock Text="～" Foreground="#334155" VerticalAlignment="Center" Margin="4,0" />
                        <DatePicker x:Name="dp_SearchDateTo" Height="30" Width="120" />
                    </StackPanel>

                    <!-- 状態 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="状態:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="cmb_SearchStatus" Width="120" Height="30" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="すべて" Tag="-1" IsSelected="True" />
                            <ComboBoxItem Content="通常" Tag="0" />
                            <ComboBoxItem Content="非表示" Tag="2" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 非表示を含む -->
                    <CheckBox x:Name="chk_IncludeHidden" Content="非表示を含む" VerticalAlignment="Center" Margin="6,4,16,4" Foreground="#334155" FontWeight="SemiBold" Click="chk_IncludeHidden_Click" />
                </WrapPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btn_Search" Style="{StaticResource ActionButtonStyle}" Background="#006666" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0" />
                            <TextBlock Text="検索" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_Clear" Style="{StaticResource ActionButtonStyle}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Click="btn_Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,4,0" />
                            <TextBlock Text="条件クリア" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. 操作ツールバー                                         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btn_NewRegister" Style="{StaticResource ActionButtonStyle}" Background="#008080" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_NewRegister_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,4,0" FontWeight="Bold" />
                        <TextBlock Text="新規入荷登録" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_DetailSelected" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Margin="0,0,8,0" IsEnabled="False" Click="btn_DetailSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Margin="0,0,4,0" />
                        <TextBlock Text="入荷詳細" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_ConfirmArrival" Style="{StaticResource ActionButtonStyle}" Background="#16A34A" Foreground="#FFFFFF" Margin="0,0,8,0" IsEnabled="False" Click="btn_ConfirmArrival_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✔" Margin="0,0,4,0" FontWeight="Bold" />
                        <TextBlock Text="検品確定" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_EditSelected" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Margin="0,0,8,0" IsEnabled="False" Click="btn_EditSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,4,0" />
                        <TextBlock Text="選択項目を編集" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_HideSelected" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Margin="0,0,8,0" IsEnabled="False" Click="btn_HideSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" Margin="0,0,4,0" />
                        <TextBlock Text="非表示設定" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_DeleteSelected" Style="{StaticResource ActionButtonStyle}" Background="#991B1B" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_DeleteSelected_Click" IsEnabled="False" Width="109">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Margin="0,0,4,0" />
                        <TextBlock Text="削除" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="txt_ArrivalCount" Grid.Column="1" Text="表示件数: 0 件" FontSize="13" Foreground="#475569" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. メイン DataGrid                                        -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,0,16,16">
            <DataGrid x:Name="dg_Arrivals"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="34"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      SelectionChanged="dg_Arrivals_SelectionChanged"
                      MouseDoubleClick="dg_Arrivals_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E2E8F0" />
                        <Setter Property="Foreground" Value="#1E293B" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="入荷ID" Binding="{Binding ArId}" Width="70" />
                    <DataGridTextColumn Header="受注ID" Binding="{Binding OrId}" Width="70" />
                    <DataGridTextColumn Header="顧客名" Binding="{Binding ClientName}" Width="130" />
                    <DataGridTextColumn Header="商品ID" Binding="{Binding PrId}" Width="70" />
                    <DataGridTextColumn Header="商品名" Binding="{Binding PrName}" Width="170" />
                    <DataGridTextColumn Header="メーカー" Binding="{Binding MaName}" Width="120" />
                    <DataGridTextColumn Header="入荷数量" Binding="{Binding ArQuantityFormatted}" Width="85" />
                    <DataGridTextColumn Header="単価" Binding="{Binding PriceFormatted}" Width="90" />
                    <DataGridTextColumn Header="入荷日" Binding="{Binding ArDateFormatted}" Width="100" />
                    <DataGridTextColumn Header="検品状態" Binding="{Binding StateFormatted}" Width="85" />
                    <DataGridTextColumn Header="フラグ" Binding="{Binding ArFlagFormatted}" Width="75" />
                    <DataGridTextColumn Header="備考 / 非表示理由" Binding="{Binding ArHidden}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ======================================================== -->
        <!-- モーダル: 入荷登録                                         -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_ArrivalRegister" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_ArrivalRegister_Backdrop_MouseLeftButtonDown" />
            <Border Width="620" MaxHeight="640" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="30" ShadowDepth="8" Direction="270" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ヘッダー -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#E0F2F1" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                    <TextBlock Text="+" FontSize="24" Foreground="#00796B" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="新規入荷登録" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                                    <TextBlock Text="入荷テーブルへ新しいレコードを登録します。" FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseArrivalRegister_Click">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- アラートバナー -->
                        <Border x:Name="border_RegErrorAlert" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="txt_RegErrorMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="border_RegSuccessAlert" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="txt_RegSuccessMessage" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <!-- フォーム: 受注選択 -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="対象受注 (顧客・注文連携) *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <ComboBox x:Name="reg_cmb_Order" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="DisplayText" SelectedValuePath="OrId" SelectionChanged="reg_cmb_Order_SelectionChanged" />
                        </StackPanel>

                        <!-- フォーム: 商品選択 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="商品 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox x:Name="reg_cmb_Product" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="DisplayText" SelectedValuePath="PrId" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="入荷数量 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox x:Name="reg_txt_Quantity" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="6" Width="100" />
                            </StackPanel>
                        </Grid>

                        <!-- フォーム: 入荷日 & 状態 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="入荷日 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <DatePicker x:Name="reg_dp_ArDate" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="管理フラグ" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox x:Name="reg_cmb_Flag" Height="36" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="通常" Tag="0" IsSelected="True" />
                                    <ComboBoxItem Content="非表示" Tag="2" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- フォーム: 備考 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="備考 / 非表示理由" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="reg_txt_Hidden" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="100" />
                        </StackPanel>

                        <!-- ボタン -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btn_CloseArrivalRegister_Click" />
                            <Button Grid.Column="1" Content="入荷情報を登録" Style="{StaticResource PrimaryButtonStyle}" Click="btn_ExecuteArrivalRegister_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- モーダル: 入荷更新                                         -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_ArrivalUpdate" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_ArrivalUpdate_Backdrop_MouseLeftButtonDown" />
            <Border Width="640" MaxHeight="660" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="30" ShadowDepth="8" Direction="270" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ヘッダー -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                    <TextBlock Text="✎" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="入荷情報更新" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                                    <TextBlock Text="入荷テーブルにある情報を更新します。" FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseArrivalUpdate_Click">
                                <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <!-- 対象ID検索バー -->
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="対象入荷ID:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox Grid.Column="1" x:Name="upd_txt_SearchArId" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" KeyUp="upd_txt_SearchArId_KeyUp" />
                                <Button Grid.Column="2" Content="情報呼び出し" Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="8,0,0,0" Click="btn_LoadArrivalForUpdate_Click" />
                                <TextBlock Grid.Column="3" Text="Enterキーで呼出可能" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </Grid>
                        </Border>

                        <!-- アラートバナー -->
                        <Border x:Name="border_UpdErrorAlert" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="txt_UpdErrorMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                        <Border x:Name="border_UpdSuccessAlert" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                            <TextBlock x:Name="txt_UpdSuccessMessage" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>

                        <!-- 編集フォーム: 商品 & 入荷数量 -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="商品 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox x:Name="upd_cmb_Product" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="DisplayText" SelectedValuePath="PrId" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="入荷数量 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox x:Name="upd_txt_Quantity" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="6" Width="100" />
                            </StackPanel>
                        </Grid>

                        <!-- 入荷日 & 管理フラグ -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="入荷日" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <DatePicker x:Name="upd_dp_ArDate" Height="36" VerticalContentAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="管理フラグ *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox x:Name="upd_cmb_Flag" Height="36" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="通常表示" Tag="0" />
                                    <ComboBoxItem Content="非表示" Tag="2" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- 備考 / 非表示理由 -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="備考 / 非表示理由" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="upd_txt_Hidden" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="100" />
                        </StackPanel>

                        <!-- ボタン -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="閉じる" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btn_CloseArrivalUpdate_Click" />
                            <Button Grid.Column="1" Content="入荷情報を更新" Style="{StaticResource PrimaryButtonStyle}" Click="btn_ExecuteArrivalUpdate_Click" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- モーダル: 入荷非表示設定                                   -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_ArrivalHide" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_ArrivalHide_Backdrop_MouseLeftButtonDown" />
            <Border Width="560" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="30" ShadowDepth="8" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <!-- ヘッダー -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEE2E2" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="⊘" FontSize="22" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="入荷非表示 (フラグ)" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                                <TextBlock Text="選択された入荷の管理フラグを 0 から 2 に更新します。" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseArrivalHide_Click">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- 対象入荷情報プレビューカード -->
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="入荷ID" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayArId" Text="-" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="商品名" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayPrName" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="入荷日" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayArDate" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="現在の管理フラグ" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayFlag" Text="-" FontSize="13" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- アラートバナー -->
                    <Border x:Name="border_HideErrorAlert" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_HideErrorMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="border_HideSuccessAlert" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_HideSuccessMessage" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- 非表示理由 -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="非表示理由 (備考)" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="hide_txt_Reason" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="100" />
                    </StackPanel>

                    <!-- ボタン -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btn_CloseArrivalHide_Click" />
                        <Button Grid.Column="1" Content="管理フラグを 2 (非表示) に更新" Style="{StaticResource DangerButtonStyle}" Click="btn_ExecuteArrivalHide_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- モーダル: 入荷詳細表示 (T_ArrivalDetail) -->
        <Grid x:Name="modal_Detail" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_Detail_Backdrop_Click"/>
            <Border Width="620" MaxHeight="650" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="25" ShadowDepth="6" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- ヘッダー -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E0F2FE" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="🔍" FontSize="16" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="入荷詳細情報" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock x:Name="detail_txt_Header" Text="入荷情報および入荷詳細テーブル（T_ArrivalDetail）の確認" FontSize="11" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseDetail_Click">
                            <TextBlock Text="✕" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Separator Background="#E2E8F0" Margin="0,0,0,14"/>

                    <!-- ヘッダーサマリー -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="6"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="detail_txt_ArId" Text="入荷ID: -" FontWeight="Bold" Foreground="#1E3A5F"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="detail_txt_Client" Text="顧客名: -" FontWeight="Bold" Foreground="#1E3A5F"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="detail_txt_Date" Text="入荷日: -" Foreground="#475569"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="detail_txt_Office" Text="営業所: -" Foreground="#475569"/>
                        </Grid>
                    </Border>

                    <!-- 詳細テーブル DataGrid -->
                    <TextBlock Text="入荷詳細テーブル（T_ArrivalDetail）" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16" MaxHeight="220">
                        <DataGrid x:Name="dg_ArrivalDetailItems"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeight="28"
                                  AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E2E8F0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Height" Value="28"/>
                                    <Setter Property="Padding" Value="8,0"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="入荷詳細ID" Binding="{Binding ArDetailId}" Width="95"/>
                                <DataGridTextColumn Header="入荷ID" Binding="{Binding ArId}" Width="75"/>
                                <DataGridTextColumn Header="商品ID" Binding="{Binding PrId}" Width="75"/>
                                <DataGridTextColumn Header="商品名" Binding="{Binding PrName}" Width="*"/>
                                <DataGridTextColumn Header="数量" Binding="{Binding ArQuantity}" Width="85"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ボタン -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Click="btn_CloseDetail_Click" Content="閉じる" MinWidth="80"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>