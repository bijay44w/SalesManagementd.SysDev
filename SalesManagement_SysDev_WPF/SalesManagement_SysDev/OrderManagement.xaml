<UserControl x:Class="SalesManagement_SysDev.OrderManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="av"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="13"
             av:DesignHeight="600">

    <UserControl.Resources>

        <!-- 操作ボタン -->
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 検索用TextBox -->
        <Style x:Key="RetroTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- メインボタン -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#006666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- サブボタン -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- モーダルTextBox -->
        <Style x:Key="ModalTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- モーダルComboBox -->
        <Style x:Key="ModalComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- DataGridヘッダー -->
        <Style x:Key="OrderDataGridHeaderStyle"
               TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="#EAF0F6"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="BorderBrush" Value="#D5DEE8"/>
        </Style>

        <!-- DataGridセル -->
        <Style x:Key="OrderDataGridCellStyle"
               TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="Transparent"/>

            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 注文一覧の行 -->
        <Style x:Key="OrderRowStyle"
               TargetType="{x:Type DataGridRow}">
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#334155"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F7FC"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0078D7"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 商品名：折り返し・選択時は白文字 -->
        <Style x:Key="ProductNameWrapStyle"
               TargetType="{x:Type TextBlock}">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="None"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Padding" Value="2"/>

            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type DataGridCell}},
                                      Path=IsSelected}"
                    Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルバー -->
        <Border Grid.Row="0"
                Background="#004D40"
                Padding="18,10"
                BorderBrush="#00332C"
                BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#26A69A"
                            Width="32"
                            Height="32"
                            CornerRadius="4"
                            Margin="0,0,10,0">
                        <TextBlock Text="≡"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="注文管理"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>
                        <TextBlock Text="注文情報の検索・一覧・登録・更新・非表示管理"
                                   FontSize="10"
                                   Foreground="#80CBC4"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="【注文検索 / 一覧管理】"
                           FontSize="11"
                           Foreground="#E0F2F1"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- 検索条件 -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Margin="16,10,16,6"
                Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal"
                                Margin="0,3,12,3"
                                VerticalAlignment="Center">
                        <TextBlock Text="注文番号:"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBox x:Name="txt_SearchOrderId"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Width="100"
                                 KeyDown="SearchField_KeyDown"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,3,12,3"
                                VerticalAlignment="Center">
                        <TextBlock Text="顧客名:"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <TextBox x:Name="txt_SearchCustomerName"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Width="145"
                                 KeyDown="SearchField_KeyDown"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,3,12,3"
                                VerticalAlignment="Center">
                        <TextBlock Text="注文状態:"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <ComboBox x:Name="cmb_SearchStatus"
                                  Width="115"
                                  Height="30"
                                  VerticalContentAlignment="Center">
                            <ComboBoxItem Content="すべて" IsSelected="True"/>
                            <ComboBoxItem Content="受付中"/>
                            <ComboBoxItem Content="処理中"/>
                            <ComboBoxItem Content="完了"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,3,12,3"
                                VerticalAlignment="Center">
                        <TextBlock Text="注文期間:"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,5,0"/>
                        <DatePicker x:Name="dp_SearchStartDate"
                                    Width="125"
                                    Height="30"
                                    VerticalContentAlignment="Center"/>
                        <TextBlock Text="～"
                                   Margin="4,0"
                                   VerticalAlignment="Center"
                                   Foreground="#334155"/>
                        <DatePicker x:Name="dp_SearchEndDate"
                                    Width="125"
                                    Height="30"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <CheckBox x:Name="chk_IncludeHidden"
                              Content="非表示を含む"
                              VerticalAlignment="Center"
                              Margin="4,3,12,3"
                              Foreground="#334155"
                              FontWeight="SemiBold"
                              Click="chk_IncludeHidden_Click"/>
                </WrapPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0">
                    <Button x:Name="btn_Search"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#006666"
                            Foreground="#FFFFFF"
                            Margin="0,0,7,0"
                            Click="btn_Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌕" Margin="0,0,4,0"/>
                            <TextBlock Text="検索" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btn_Clear"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#F1F5F9"
                            Foreground="#334155"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            Click="btn_Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,4,0"/>
                            <TextBlock Text="条件クリア"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 操作ツールバー -->
        <Grid Grid.Row="2"
              Margin="16,0,16,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button x:Name="btn_Register"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#008080"
                        Foreground="#FFFFFF"
                        Margin="0,0,7,0"
                        Click="btn_Register_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,4,0"/>
                        <TextBlock Text="新規注文登録" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_Update"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#0284C7"
                        Foreground="#FFFFFF"
                        Margin="0,0,7,0"
                        IsEnabled="False"
                        Click="btn_Update_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,4,0"/>
                        <TextBlock Text="選択項目の変更" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_Confirm"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#16A34A"
                        Foreground="#FFFFFF"
                        Margin="0,0,7,0"
                        IsEnabled="False"
                        Click="btn_Confirm_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✓" Margin="0,0,4,0"/>
                        <TextBlock Text="注文確定・出庫送信" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_Hide"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#DC2626"
                        Foreground="#FFFFFF"
                        Margin="0,0,7,0"
                        IsEnabled="False"
                        Click="btn_Hide_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" Margin="0,0,4,0"/>
                        <TextBlock Text="非表示設定" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_Delete"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#991B1B"
                        Foreground="#FFFFFF"
                        Margin="0,0,7,0"
                        IsEnabled="False"
                        Width="109"
                        Click="btn_Delete_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Margin="0,0,4,0"/>
                        <TextBlock Text="削除" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="txt_OrderCount"
                       Grid.Column="1"
                       Text="表示件数: 0 件"
                       FontSize="12"
                       Foreground="#475569"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- 注文一覧 -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Margin="16,0,16,16">

            <DataGrid x:Name="dg_Orders"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeColumns="True"
                      CanUserReorderColumns="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      MinRowHeight="36"
                      ColumnHeaderHeight="36"
                      Background="#FFFFFF"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#F7FAFC"
                      BorderThickness="0"
                      ColumnHeaderStyle="{StaticResource OrderDataGridHeaderStyle}"
                      CellStyle="{StaticResource OrderDataGridCellStyle}"
                      RowStyle="{StaticResource OrderRowStyle}"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionChanged="dg_Orders_SelectionChanged"
                      MouseDoubleClick="dg_Orders_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="注文番号"
                                        Binding="{Binding OrderId}"
                                        Width="1.0*"
                                        MinWidth="85"/>

                    <DataGridTextColumn Header="顧客名"
                                        Binding="{Binding CustomerName}"
                                        Width="1.1*"
                                        MinWidth="95"/>

                    <!-- 商品名：折り返し表示・選択時は白文字 -->
                    <DataGridTextColumn Header="商品名"
                                        Binding="{Binding ProductName}"
                                        Width="2*"
                                        MinWidth="150"
                                        ElementStyle="{StaticResource ProductNameWrapStyle}"/>

                    <DataGridTextColumn Header="注文数量"
                                        Binding="{Binding Quantity}"
                                        Width="0.7*"
                                        MinWidth="70"/>

                    <DataGridTextColumn Header="確定フラグ"
                                        Binding="{Binding OrderStatusFlag}"
                                        Width="0.8*"
                                        MinWidth="80"/>

                    <DataGridTextColumn Header="注文日"
                                        Binding="{Binding OrderDate, StringFormat={}{0:yyyy/MM/dd}}"
                                        Width="0.9*"
                                        MinWidth="90"/>

                    <DataGridTextColumn Header="注文状態"
                                        Binding="{Binding OrderStatus}"
                                        Width="0.8*"
                                        MinWidth="80"/>

                    <DataGridTextColumn Header="合計金額"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N0} 円}"
                                        Width="0.9*"
                                        MinWidth="95"/>

                    <DataGridTextColumn Header="状態"
                                        Binding="{Binding FlagFormatted}"
                                        Width="0.7*"
                                        MinWidth="75"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 注文登録・編集モーダル -->
        <Grid x:Name="modal_OrderEdit"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              Panel.ZIndex="1000">

            <Border Background="#66000000"
                    MouseLeftButtonDown="modal_OrderEdit_Backdrop_MouseLeftButtonDown"/>

            <Border Width="540"
                    MaxHeight="560"
                    Margin="8"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.18"
                                      BlurRadius="18"
                                      ShadowDepth="3"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- タイトル -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,4">
                        <TextBlock x:Name="txt_EditTitle"
                                   Text="注文登録"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#00665F"/>

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="26"
                                Height="26"
                                Margin="0,0,8,0"
                                Background="#F1F5F9"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btn_CloseEdit_Click">
                            <TextBlock Text="×"
                                       FontSize="17"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- 入力フォーム -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- エラー -->
                            <Border x:Name="border_EditError"
                                    Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,4"
                                    Margin="0,0,0,5"
                                    Visibility="Collapsed">
                                <TextBlock x:Name="txt_EditError"
                                           Foreground="#B91C1C"
                                           FontSize="10"
                                           TextWrapping="Wrap"/>
                            </Border>

                            <!-- 注文番号：編集時のみ表示 -->
                            <StackPanel x:Name="panel_EditOrderId"
                                        Margin="0,0,0,4"
                                        Visibility="Collapsed">
                                <TextBlock Text="注文番号"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#334155"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="txt_EditOrderId"
                                         Style="{StaticResource ModalTextBoxStyle}"
                                         IsReadOnly="True"
                                         Background="#F1F5F9"/>
                            </StackPanel>

                            <!-- 顧客名 -->
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="顧客名 *"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#334155"
                                           Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmb_EditCustomer"
                                          Style="{StaticResource ModalComboBoxStyle}"
                                          DisplayMemberPath="ClName"
                                          SelectedValuePath="ClId"
                                          IsEditable="False"/>
                            </StackPanel>

                            <!-- 注文日 -->
                            <StackPanel Margin="0,0,0,5">
                                <TextBlock Text="注文日 *"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#334155"
                                           Margin="0,0,0,2"/>
                                <DatePicker x:Name="dp_EditOrderDate"
                                            Height="26"
                                            FontSize="11"
                                            VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <!-- 商品選択 -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="85"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Margin="0,0,7,0">
                                    <TextBlock Text="商品名 *"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="#334155"
                                               Margin="0,0,0,2"/>
                                    <ComboBox x:Name="cmb_EditProduct"
                                              Style="{StaticResource ModalComboBoxStyle}"
                                              DisplayMemberPath="PrName"
                                              SelectedValuePath="PrId"
                                              IsEditable="False"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="数量 *"
                                               FontWeight="SemiBold"
                                               FontSize="11"
                                               Foreground="#334155"
                                               Margin="0,0,0,2"/>
                                    <TextBox x:Name="txt_EditQuantity"
                                             Style="{StaticResource ModalTextBoxStyle}"
                                             MaxLength="8"
                                             Text="1"/>
                                </StackPanel>
                            </Grid>

                            <!-- 商品金額 -->
                            <StackPanel Orientation="Horizontal"
                                        Margin="0,0,0,4"
                                        VerticalAlignment="Center">
                                <TextBlock Text="商品金額"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="#64748B"
                                           Margin="0,0,10,0"/>
                                <TextBlock x:Name="txt_DetailAmount"
                                           Text="0 円"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#334155"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 明細操作ボタン -->
                            <WrapPanel Margin="0,0,0,4">
                                <Button Content="＋ 明細追加"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="10"
                                        Margin="0,0,5,3"
                                        Click="btn_AddDetail_Click"/>

                                <Button Content="選択明細を変更"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="10"
                                        Background="#0284C7"
                                        Foreground="#FFFFFF"
                                        Margin="0,0,5,3"
                                        Click="btn_UpdateDetail_Click"/>

                                <Button Content="選択明細を削除"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Height="26"
                                        Padding="8,0"
                                        FontSize="10"
                                        Background="#DC2626"
                                        Foreground="#FFFFFF"
                                        Margin="0,0,0,3"
                                        Click="btn_RemoveDetail_Click"/>
                            </WrapPanel>

                            <!-- 商品一覧 -->
                            <DataGrid x:Name="dg_EditDetails"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      Height="95"
                                      RowHeight="23"
                                      ColumnHeaderHeight="26"
                                      FontSize="10"
                                      GridLinesVisibility="Horizontal"
                                      HeadersVisibility="Column"
                                      Background="#FFFFFF"
                                      BorderBrush="#CBD5E1"
                                      BorderThickness="1"
                                      AlternatingRowBackground="#F8FAFC"
                                      ColumnHeaderStyle="{StaticResource OrderDataGridHeaderStyle}"
                                      CellStyle="{StaticResource OrderDataGridCellStyle}"
                                      SelectionChanged="dg_EditDetails_SelectionChanged"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品名"
                                                        Binding="{Binding ProductName}"
                                                        Width="2*"
                                                        MinWidth="110"/>
                                    <DataGridTextColumn Header="数量"
                                                        Binding="{Binding Quantity}"
                                                        Width="0.7*"
                                                        MinWidth="50"/>
                                    <DataGridTextColumn Header="単価"
                                                        Binding="{Binding UnitPrice, StringFormat={}{0:N0} 円}"
                                                        Width="1.2*"
                                                        MinWidth="85"/>
                                    <DataGridTextColumn Header="金額"
                                                        Binding="{Binding TotalPrice, StringFormat={}{0:N0} 円}"
                                                        Width="1.3*"
                                                        MinWidth="95"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- 注文状態 -->
                            <StackPanel Margin="0,0,0,4">
                                <TextBlock Text="注文状態"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#334155"
                                           Margin="0,0,0,2"/>
                                <ComboBox x:Name="cmb_EditOrderStatus"
                                          Style="{StaticResource ModalComboBoxStyle}"
                                          IsEnabled="False">
                                    <ComboBoxItem Content="受付中"/>
                                    <ComboBoxItem Content="処理中"/>
                                    <ComboBoxItem Content="完了"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- 合計金額 -->
                            <StackPanel Margin="0,0,0,5">
                                <TextBlock Text="合計金額"
                                           FontWeight="SemiBold"
                                           FontSize="11"
                                           Foreground="#334155"
                                           Margin="0,0,0,2"/>
                                <TextBox x:Name="txt_EditTotalAmount"
                                         Style="{StaticResource ModalTextBoxStyle}"
                                         IsReadOnly="True"
                                         Background="#F1F5F9"
                                         FontWeight="Bold"
                                         FontSize="13"/>
                            </StackPanel>

                            <!-- 保存・キャンセル -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="キャンセル"
                                        Width="82"
                                        Height="27"
                                        FontSize="10"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0,0,6,0"
                                        Click="btn_CloseEdit_Click"/>

                                <Button x:Name="btn_SaveOrder"
                                        Content="注文を登録"
                                        Width="95"
                                        Height="27"
                                        FontSize="10"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="btn_SaveOrder_Click"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
