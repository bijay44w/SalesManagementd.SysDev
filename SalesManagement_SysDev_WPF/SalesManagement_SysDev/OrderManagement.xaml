<UserControl x:Class="SalesManagement_SysDev.OrderManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="av"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="13"
             av:DesignHeight="600">

    <UserControl.Resources>

        <!-- 操作ボタン共通 -->
        <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 入力欄共通 -->
        <Style x:Key="RetroTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- メインボタン -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#006666"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- サブボタン -->
        <Style x:Key="SecondaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 非表示ボタン -->
        <Style x:Key="DangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <!-- モーダル入力欄 -->
        <Style x:Key="ModalTextBoxStyle"
               TargetType="{x:Type TextBox}"
               BasedOn="{StaticResource RetroTextBoxStyle}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================================================= -->
        <!-- 0. タイトルバー -->
        <!-- ================================================= -->
        <Border Grid.Row="0"
                Background="#004D40"
                Padding="20,12"
                BorderBrush="#00332C"
                BorderThickness="0,0,0,2">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Border Background="#26A69A"
                            Width="34"
                            Height="34"
                            CornerRadius="4"
                            Margin="0,0,12,0">

                        <TextBlock Text="≡"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="注文管理"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"/>

                        <TextBlock Text="注文情報の検索・一覧・登録・更新・非表示管理"
                                   FontSize="11"
                                   Foreground="#80CBC4"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="【注文検索 / 一覧管理】"
                           FontSize="12"
                           Foreground="#E0F2F1"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- 1. 検索条件 -->
        <!-- ================================================= -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Margin="16,12,16,8"
                Padding="14,10">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0"
                           Orientation="Horizontal"
                           VerticalAlignment="Center">

                    <!-- 注文番号 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,16,4"
                                VerticalAlignment="Center">

                        <TextBlock Text="注文番号:"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <TextBox x:Name="txt_SearchOrderId"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Width="110"
                                 KeyDown="SearchField_KeyDown"/>
                    </StackPanel>

                    <!-- 顧客名 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,16,4"
                                VerticalAlignment="Center">

                        <TextBlock Text="顧客名:"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <TextBox x:Name="txt_SearchCustomerName"
                                 Style="{StaticResource RetroTextBoxStyle}"
                                 Width="160"
                                 KeyDown="SearchField_KeyDown"/>
                    </StackPanel>

                    <!-- 注文状態 -->
                    <StackPanel Orientation="Horizontal"
                                Margin="0,4,16,4"
                                VerticalAlignment="Center">

                        <TextBlock Text="注文状態:"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0"/>

                        <ComboBox x:Name="cmb_SearchStatus"
                                  Width="130"
                                  Height="30"
                                  VerticalContentAlignment="Center">

                            <ComboBoxItem Content="すべて" IsSelected="True"/>
                            <ComboBoxItem Content="受付中"/>
                            <ComboBoxItem Content="処理中"/>
                            <ComboBoxItem Content="完了"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 非表示を含む -->
                    <CheckBox x:Name="chk_IncludeHidden"
                              Content="非表示を含む"
                              VerticalAlignment="Center"
                              Margin="6,4,16,4"
                              Foreground="#334155"
                              FontWeight="SemiBold"
                              Click="chk_IncludeHidden_Click"/>
                </WrapPanel>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,6,0,0">

                    <Button x:Name="btn_Search"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#006666"
                            Foreground="#FFFFFF"
                            Margin="0,0,8,0"
                            Click="btn_Search_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌕" Margin="0,0,4,0"/>
                            <TextBlock Text="検索" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btn_Clear"
                            Style="{StaticResource ActionButtonStyle}"
                            Background="#F1F5F9"
                            Foreground="#334155"
                            BorderBrush="#94A3B8"
                            BorderThickness="1"
                            Click="btn_Clear_Click">

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,4,0"/>
                            <TextBlock Text="条件クリア"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================================= -->
        <!-- 2. 操作ツールバー -->
        <!-- ================================================= -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">

                <Button x:Name="btn_Register"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#008080"
                        Foreground="#FFFFFF"
                        Margin="0,0,8,0"
                        Click="btn_Register_Click">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,4,0" FontWeight="Bold"/>
                        <TextBlock Text="注文登録" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_Update"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#0284C7"
                        Foreground="#FFFFFF"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="btn_Update_Click">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,4,0"/>
                        <TextBlock Text="選択項目の変更" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btn_Hide"
                        Style="{StaticResource ActionButtonStyle}"
                        Background="#DC2626"
                        Foreground="#FFFFFF"
                        Margin="0,0,8,0"
                        IsEnabled="False"
                        Click="btn_Hide_Click">

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" Margin="0,0,4,0"/>
                        <TextBlock Text="非表示設定" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="txt_OrderCount"
                       Grid.Column="1"
                       Text="表示件数: 0 件"
                       FontSize="13"
                       Foreground="#475569"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>
        </Grid>

        <!-- ================================================= -->
        <!-- 3. 注文一覧 -->
        <!-- ================================================= -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="6"
                Margin="16,0,16,16">

            <DataGrid x:Name="dg_Orders"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="34"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      SelectionChanged="dg_Orders_SelectionChanged"
                      MouseDoubleClick="dg_Orders_MouseDoubleClick">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#E2E8F0"/>
                        <Setter Property="Foreground" Value="#1E293B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Height" Value="34"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="BorderBrush" Value="#CBD5E1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="注文番号"
                                        Binding="{Binding OrderId}"
                                        Width="120"/>

                    <DataGridTextColumn Header="顧客名"
                                        Binding="{Binding CustomerName}"
                                        Width="*"/>

                    <DataGridTextColumn Header="注文日"
                                        Binding="{Binding OrderDate, StringFormat={}{0:yyyy/MM/dd}}"
                                        Width="130"/>

                    <DataGridTextColumn Header="注文状態"
                                        Binding="{Binding OrderStatus}"
                                        Width="120"/>

                    <DataGridTextColumn Header="合計金額"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N0} 円}"
                                        Width="140"/>

                    <DataGridTextColumn Header="状態"
                                        Binding="{Binding FlagFormatted}"
                                        Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ================================================= -->
        <!-- 4. 注文登録・更新モーダル -->
        <!-- ================================================= -->
        <Grid x:Name="modal_OrderEdit"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              Panel.ZIndex="1000">

            <Border Background="#66000000"
                    MouseLeftButtonDown="modal_OrderEdit_Backdrop_MouseLeftButtonDown"/>

            <Border Width="520"
                    Background="#FFFFFF"
                    CornerRadius="8"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <Border.Effect>
                    <DropShadowEffect Color="#000000"
                                      Opacity="0.18"
                                      BlurRadius="24"
                                      ShadowDepth="6"/>
                </Border.Effect>

                <StackPanel>

                    <!-- モーダルタイトル -->
                    <Grid Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Border Background="#E0F2F1"
                                    CornerRadius="6"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,12,0">

                                <TextBlock Text="≡"
                                           FontSize="22"
                                           Foreground="#008080"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>

                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txt_EditTitle"
                                           Text="注文登録"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="#1E293B"/>

                                <TextBlock Text="注文情報を入力してください。"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                        </StackPanel>

                        <Button HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Width="32"
                                Height="32"
                                Background="#F1F5F9"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="btn_CloseEdit_Click">
                            <TextBlock Text="✕"
                                       Foreground="#64748B"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <!-- エラーメッセージ -->
                    <Border x:Name="border_EditError"
                            Background="#FEF2F2"
                            BorderBrush="#FECACA"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">

                        <TextBlock x:Name="txt_EditError"
                                   Foreground="#B91C1C"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- 注文番号 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="注文番号"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txt_EditOrderId"
                                 Style="{StaticResource ModalTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F1F5F9"/>
                    </StackPanel>

                    <!-- 顧客名 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="顧客名 *"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txt_EditCustomerName"
                                 Style="{StaticResource ModalTextBoxStyle}"
                                 MaxLength="100"/>
                    </StackPanel>

                    <!-- 注文日 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="注文日 *"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,4"/>

                        <DatePicker x:Name="dp_EditOrderDate"
                                    Height="36"
                                    VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <!-- 注文状態 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="注文状態 *"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,4"/>

                        <ComboBox x:Name="cmb_EditOrderStatus"
                                  Height="36"
                                  VerticalContentAlignment="Center">

                            <ComboBoxItem Content="受付中"/>
                            <ComboBoxItem Content="処理中"/>
                            <ComboBoxItem Content="完了"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 合計金額 -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="合計金額 *"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,4"/>

                        <TextBox x:Name="txt_EditTotalAmount"
                                 Style="{StaticResource ModalTextBoxStyle}"
                                 MaxLength="12"/>
                    </StackPanel>

                    <!-- ボタン -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="キャンセル"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Margin="0,0,8,0"
                                Click="btn_CloseEdit_Click"/>

                        <Button Grid.Column="1"
                                x:Name="btn_SaveOrder"
                                Content="注文を登録"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="btn_SaveOrder_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>