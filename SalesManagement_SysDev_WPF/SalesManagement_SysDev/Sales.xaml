<UserControl x:Class="SalesManagement_SysDev.Sales"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8FD"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="14">

    <UserControl.Resources>
        <Style x:Key="SalesCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A"
                                      Opacity="0.04"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4F8FD" Offset="0"/>
                <GradientStop Color="#ECF2FB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="36,30,36,18">

            <Border Background="#DBEAFE"
                    Width="54" Height="54"
                    CornerRadius="27"
                    Margin="0,0,16,0">
                <TextBlock Text="￥"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="売上管理"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>
                <TextBlock Text="売上情報の登録・更新・検索などを管理します。"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 操作カード：3列×2行 -->
        <Grid Grid.Row="1" Margin="26,0,36,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 売上登録 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource SalesCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="+"
                                       FontSize="28"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="売上登録" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="売上情報を入力し、&#x0a;登録します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 売上更新 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource SalesCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="✎" FontSize="23"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="売上更新" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="登録済みの売上情報を確認し、&#x0a;内容を更新します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 売上一覧表示 -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource SalesCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="☷" FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="売上一覧表示" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="登録されている売上情報を&#x0a;一覧で表示します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 売上検索 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource SalesCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⌕" FontSize="30"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="売上検索" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="条件を指定して売上情報を&#x0a;検索します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 売上非表示 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource SalesCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⊘" FontSize="25"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="売上非表示" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="対象の売上情報を非表示に&#x0a;します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 6枚目は空欄 -->
            <Grid Grid.Row="1" Grid.Column="2"/>

        </Grid>
    </Grid>
</UserControl>
