<UserControl x:Class="SalesManagement_SysDev.Customer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="13">

    <UserControl.Resources>
        <!-- レトロ・業務アプリ ボタンスタイル -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RetroTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: ヘッダー -->
            <RowDefinition Height="Auto" />
            <!-- 1: 検索条件バー -->
            <RowDefinition Height="Auto" />
            <!-- 2: 操作ツールバー -->
            <RowDefinition Height="Auto" />
            <!-- 3: 一覧表 DataGrid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. タイトルバー (Retro Dark Teal)                         -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#004D40" Padding="20,12" BorderBrush="#00332C" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26A69A" Width="34" Height="34" CornerRadius="4" Margin="0,0,12,0">
                        <TextBlock Text="👥" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="顧客管理" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="顧客情報の検索・一覧・登録・更新・非表示管理" FontSize="11" Foreground="#80CBC4" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="【直接検索 / 即時反映】" FontSize="12" Foreground="#E0F2F1" VerticalAlignment="Center" Margin="0,0,10,0" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 1. 検索バー (画面上部に常駐・モーダル不要)                 -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,12,16,8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 検索フィールド群 -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- 顧客ID -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="顧客ID:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchClId" Style="{StaticResource RetroTextBoxStyle}" Width="70" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 顧客名 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="顧客名:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchClName" Style="{StaticResource RetroTextBoxStyle}" Width="150" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 電話番号 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="電話番号:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchPhone" Style="{StaticResource RetroTextBoxStyle}" Width="120" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 営業所 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="営業所:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="cmb_SearchOffice" Width="140" Height="30" VerticalContentAlignment="Center" DisplayMemberPath="SoName" SelectedValuePath="SoId" />
                    </StackPanel>

                    <!-- 非表示を含む -->
                    <CheckBox x:Name="chk_IncludeHidden" Content="非表示を含む" VerticalAlignment="Center" Margin="6,4,16,4" Foreground="#334155" FontWeight="SemiBold" Click="chk_IncludeHidden_Click" />
                </WrapPanel>

                <!-- 検索・クリアボタン群 -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btn_Search" Style="{StaticResource ActionButtonStyle}" Background="#006666" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0" />
                            <TextBlock Text="検索" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_Clear" Style="{StaticResource ActionButtonStyle}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Click="btn_Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,4,0" />
                            <TextBlock Text="条件クリア" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. 操作ツールバー (新規登録・編集・非表示・件数表示)        -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- アクションボタン -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btn_NewRegister" Style="{StaticResource ActionButtonStyle}" Background="#008080" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_NewRegister_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,4,0" FontWeight="Bold" />
                        <TextBlock Text="新規顧客登録" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_EditSelected" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_EditSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,4,0" />
                        <TextBlock Text="選択項目を編集" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_HideSelected" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_HideSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" Margin="0,0,4,0" />
                        <TextBlock Text="非表示設定" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- 件数表示 -->
            <TextBlock x:Name="txt_RecordCount" Grid.Column="1" Text="表示件数: 0 件" FontSize="13" Foreground="#475569" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. メイン DataGrid (即座に表示・ダブルクリックで編集)       -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,0,16,16">
            <DataGrid x:Name="dg_Customers"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="34"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      SelectionChanged="dg_Customers_SelectionChanged"
                      MouseDoubleClick="dg_Customers_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E2E8F0" />
                        <Setter Property="Foreground" Value="#1E293B" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="顧客ID" Binding="{Binding ClId}" Width="80" />
                    <DataGridTextColumn Header="顧客名" Binding="{Binding ClName}" Width="180" />
                    <DataGridTextColumn Header="所属営業所" Binding="{Binding SoName}" Width="130" />
                    <DataGridTextColumn Header="郵便番号" Binding="{Binding ClPostal}" Width="100" />
                    <DataGridTextColumn Header="住所" Binding="{Binding ClAddress}" Width="*" />
                    <DataGridTextColumn Header="電話番号" Binding="{Binding ClPhone}" Width="130" />
                    <DataGridTextColumn Header="FAX" Binding="{Binding ClFax}" Width="130" />
                    <DataGridTextColumn Header="状態" Binding="{Binding FlagDisplay}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ======================================================== -->
        <!-- モーダル: 顧客新規登録                                   -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_Register" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_Register_Backdrop_Click" />
            <Border Width="500" Background="#FFFFFF" CornerRadius="10" BorderBrush="#94A3B8" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="20" ShadowDepth="6" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <!-- ヘッダー -->
                    <TextBlock Text="新規顧客登録" FontSize="18" FontWeight="Bold" Foreground="#004D40" Margin="0,0,0,16" />

                    <!-- 入力フィールド -->
                    <TextBlock Text="顧客名 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="reg_txt_ClName" Style="{StaticResource RetroTextBoxStyle}" Margin="0,0,0,10" />

                    <TextBlock Text="所属営業所 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <ComboBox x:Name="reg_cmb_Office" Height="30" DisplayMemberPath="SoName" SelectedValuePath="SoId" Margin="0,0,0,10" />

                    <TextBlock Text="郵便番号" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="reg_txt_ClPostal" Style="{StaticResource RetroTextBoxStyle}" Margin="0,0,0,10" />

                    <TextBlock Text="住所 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="reg_txt_ClAddress" Style="{StaticResource RetroTextBoxStyle}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="電話番号 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="reg_txt_ClPhone" Style="{StaticResource RetroTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FAX" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="reg_txt_ClFax" Style="{StaticResource RetroTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <!-- ボタン -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="キャンセル" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,8,0" Click="btn_CancelRegister_Click" />
                        <Button Style="{StaticResource ActionButtonStyle}" Content="登録実行" Background="#006666" Foreground="#FFFFFF" Click="btn_ExecuteRegister_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- モーダル: 顧客情報更新                                   -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_Update" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_Update_Backdrop_Click" />
            <Border Width="500" Background="#FFFFFF" CornerRadius="10" BorderBrush="#94A3B8" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="20" ShadowDepth="6" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="顧客情報編集" FontSize="18" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,0,16" />

                    <TextBlock Text="顧客ID" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,4" />
                    <TextBox x:Name="upd_txt_ClId" Style="{StaticResource RetroTextBoxStyle}" IsReadOnly="True" Background="#F1F5F9" Margin="0,0,0,10" />

                    <TextBlock Text="顧客名 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="upd_txt_ClName" Style="{StaticResource RetroTextBoxStyle}" Margin="0,0,0,10" />

                    <TextBlock Text="所属営業所 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <ComboBox x:Name="upd_cmb_Office" Height="30" DisplayMemberPath="SoName" SelectedValuePath="SoId" Margin="0,0,0,10" />

                    <TextBlock Text="郵便番号" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="upd_txt_ClPostal" Style="{StaticResource RetroTextBoxStyle}" Margin="0,0,0,10" />

                    <TextBlock Text="住所 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="upd_txt_ClAddress" Style="{StaticResource RetroTextBoxStyle}" Margin="0,0,0,10" />

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="電話番号 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="upd_txt_ClPhone" Style="{StaticResource RetroTextBoxStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FAX" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="upd_txt_ClFax" Style="{StaticResource RetroTextBoxStyle}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="キャンセル" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,8,0" Click="btn_CancelUpdate_Click" />
                        <Button Style="{StaticResource ActionButtonStyle}" Content="更新保存" Background="#0284C7" Foreground="#FFFFFF" Click="btn_ExecuteUpdate_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- モーダル: 顧客非表示設定                                 -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_Hide" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_Hide_Backdrop_Click" />
            <Border Width="450" Background="#FFFFFF" CornerRadius="10" BorderBrush="#94A3B8" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.2" BlurRadius="20" ShadowDepth="6" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="顧客非表示設定 (論理削除)" FontSize="18" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,12" />
                    <TextBlock x:Name="hide_txt_TargetInfo" Text="顧客: -" FontSize="14" Foreground="#1E293B" Margin="0,0,0,12" FontWeight="SemiBold" />

                    <TextBlock Text="非表示理由" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <TextBox x:Name="hide_txt_Reason" Style="{StaticResource RetroTextBoxStyle}" Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}" Content="キャンセル" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,8,0" Click="btn_CancelHide_Click" />
                        <Button Style="{StaticResource ActionButtonStyle}" Content="非表示に設定" Background="#DC2626" Foreground="#FFFFFF" Click="btn_ExecuteHide_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
