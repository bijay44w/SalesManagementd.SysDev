<UserControl x:Class="SalesManagement_SysDev.Customer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8FD"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="14">

    <UserControl.Resources>

        <!-- 顧客管理カードの共通スタイル -->
        <Style x:Key="CustomerCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A"
                                      Opacity="0.04"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>
        <!-- 背景 -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4F8FD" Offset="0"/>
                <GradientStop Color="#ECF2FB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="36,30,36,18">

            <Border Background="#DBEAFE"
                    Width="54"
                    Height="54"
                    CornerRadius="27"
                    Margin="0,0,16,0">

                <TextBlock Text="♟"
                           FontSize="27"
                           Foreground="#2563EB"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>

            <StackPanel VerticalAlignment="Center">

                <TextBlock Text="顧客管理"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="顧客情報を管理し、スムーズな取引をサポートします。"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>

            </StackPanel>
        </StackPanel>

        <!-- 操作カード：3列×2行 -->
        <Grid Grid.Row="1"
              Margin="26,0,36,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== -->
            <!-- 顧客登録 -->
            <!-- ==================== -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CustomerCardStyle}"
                    MouseLeftButtonUp="card_ClientRegister_MouseLeftButtonUp">

                <Grid>
                    <StackPanel VerticalAlignment="Top">

                        <Border Background="#EFF6FF"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">

                            <Path Fill="#2563EB"
                                  Width="20"
                                  Height="20"
                                  Stretch="Uniform"
                                  Data="M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm-9-2V7H4v3H1v2h3v3h2v-3h3v-2H6zm9 4c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                        </Border>

                        <TextBlock Text="顧客登録"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="新しい顧客の情報を入力し、&#x0a;登録します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- 右下の矢印 -->
                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                        <Path Fill="#2563EB"
                              Width="13"
                              Height="13"
                              Stretch="Uniform"
                              Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ==================== -->
            <!-- 顧客更新 -->
            <!-- ==================== -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CustomerCardStyle}">

                <Grid>
                    <StackPanel VerticalAlignment="Top">

                        <Border Background="#EFF6FF"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">

                            <TextBlock Text="✎"
                                       FontSize="23"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="顧客更新"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="既存の顧客情報を検索し、&#x0a;内容を確認・更新します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ==================== -->
            <!-- 顧客一覧表示 -->
            <!-- ==================== -->
            <Border Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource CustomerCardStyle}">

                <Grid>
                    <StackPanel VerticalAlignment="Top">

                        <Border Background="#EFF6FF"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">

                            <TextBlock Text="☷"
                                       FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="顧客一覧表示"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="登録されている顧客情報を&#x0a;一覧で表示します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ==================== -->
            <!-- 顧客検索 -->
            <!-- ==================== -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource CustomerCardStyle}">

                <Grid>
                    <StackPanel VerticalAlignment="Top">

                        <Border Background="#EFF6FF"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">

                            <TextBlock Text="⌕"
                                       FontSize="30"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="顧客検索"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="顧客の名前や電話番号などで検索し、&#x0a;該当する情報を表示します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                </Grid>
            </Border>

            <!-- ==================== -->
            <!-- 顧客非表示（フラグ） -->
            <!-- ==================== -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource CustomerCardStyle}">

                <Grid>
                    <StackPanel VerticalAlignment="Top">

                        <Border Background="#EFF6FF"
                                Width="44"
                                Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">

                            <TextBlock Text="◉"
                                       FontSize="25"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="顧客非表示（フラグ）"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="顧客を非表示に設定（論理削除）&#x0a;します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <Border Width="36"
                            Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">

                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                </Grid>
            </Border>

            <!-- 6枚目は空欄 -->
            <Grid Grid.Row="1"
                  Grid.Column="2"/>

        </Grid>
    </Grid>
</UserControl>