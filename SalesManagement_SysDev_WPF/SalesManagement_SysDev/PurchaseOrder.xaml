<UserControl x:Class="SalesManagement_SysDev.PurchaseOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8FD"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="14">

    <UserControl.Resources>
        <Style x:Key="PurchaseOrderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A"
                                      Opacity="0.04"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4F8FD" Offset="0"/>
                <GradientStop Color="#ECF2FB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトルエリア -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="36,30,36,18">

            <Border Background="#DBEAFE"
                    Width="54"
                    Height="54"
                    CornerRadius="27"
                    Margin="0,0,16,0">
                <Path Fill="#2563EB"
                      Width="26"
                      Height="26"
                      Stretch="Uniform"
                      Data="M4 4h16v3H4z M4 9h16v3H4z M4 14h10v3H4z"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="発注管理"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="商品の発注登録・更新・検索などの発注情報を管理します。"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 操作カード：3列×2行 -->
        <Grid Grid.Row="1"
              Margin="26,0,36,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 発注登録 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource PurchaseOrderCardStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="+"
                                       FontSize="28"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="発注登録"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="仕入先や商品、数量などを入力し、&#x0a;新しい発注情報を登録します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 発注更新 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource PurchaseOrderCardStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="✎"
                                       FontSize="23"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="発注更新"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="登録済みの発注情報を検索し、&#x0a;内容を編集・更新します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 発注一覧表示 -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource PurchaseOrderCardStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="☷"
                                       FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="発注一覧表示"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="登録されている発注情報を&#x0a;一覧で表示します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 発注検索 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource PurchaseOrderCardStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⌕"
                                       FontSize="30"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="発注検索"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="発注番号や仕入先などの条件で&#x0a;発注情報を検索します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 発注非表示 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource PurchaseOrderCardStyle}">
                <Grid>
                    <StackPanel VerticalAlignment="Top">
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⊘"
                                       FontSize="25"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="発注非表示"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="選択した発注情報を一覧から&#x0a;非表示にします。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 6枚目は空欄 -->
            <Grid Grid.Row="1" Grid.Column="2"/>

        </Grid>
    </Grid>
</UserControl>