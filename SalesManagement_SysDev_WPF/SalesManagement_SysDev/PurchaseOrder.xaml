<UserControl x:Class="SalesManagement_SysDev.PurchaseOrder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9"
             FontFamily="Yu Gothic UI"
             FontSize="13">

    <UserControl.Resources>

        <!-- カラー -->
        <SolidColorBrush x:Key="HeaderColor" Color="#00574F"/>
        <SolidColorBrush x:Key="AccentColor" Color="#00A99D"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#007F79"/>
        <SolidColorBrush x:Key="BorderColor" Color="#C9D5E4"/>
        <SolidColorBrush x:Key="TextColor" Color="#243B5A"/>
        <SolidColorBrush x:Key="BackgroundColor" Color="#F1F5F9"/>

        <!-- 共通ボタン -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="105"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#007F79"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- マウスオーバー -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.82"/>
                            </Trigger>

                            <!-- 押下時 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.68"/>
                            </Trigger>

                            <!-- 無効時は薄くする -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 新規登録：青緑色 -->
        <Style x:Key="RegisterButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#008080"/>
        </Style>

        <!-- 編集：未選択時は無効、選択時は青色 -->
        <Style x:Key="EditButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="IsEnabled" Value="False"/>

        </Style>

        <!-- 非表示：未選択時は無効、選択時は赤色 -->
        <Style x:Key="HideButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">

            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="IsEnabled" Value="False"/>

        </Style>

        <!-- 条件クリア -->
        <Style x:Key="ClearButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#B8C8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- 検索入力欄 -->
        <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="7,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="BorderBrush" Value="#9CAFC7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 検索コンボボックス -->
        <Style x:Key="SearchComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="#F1F1F1"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="BorderBrush" Value="#AAB7C8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 日付入力欄 -->
        <Style x:Key="EditDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#9CAFC7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- 発注一覧 -->
        <Style x:Key="PurchaseDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="BorderBrush" Value="#C9D5E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#DCE4ED"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E4EAF1"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="RowBackground" Value="#F8FAFC"/>
            <Setter Property="AlternatingRowBackground" Value="#F0F4F8"/>
        </Style>

        <!-- 一覧ヘッダー -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 一覧セル -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 一覧行 -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0F2FE"/>
                </Trigger>

                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#BFDBFE"/>
                    <Setter Property="Foreground" Value="#1E3A5F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 検索項目ラベル -->
        <Style x:Key="SearchLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundColor}">

        <Grid.RowDefinitions>
            <RowDefinition Height="67"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ====================================== -->
        <!-- タイトルバー -->
        <!-- ====================================== -->
        <Border Grid.Row="0"
                Background="{StaticResource HeaderColor}"
                BorderBrush="#003F39"
                BorderThickness="0,0,0,2">

            <Grid Margin="20,0,20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- アイコン -->
                <Border Grid.Column="0"
                        Width="35"
                        Height="35"
                        CornerRadius="5"
                        Background="{StaticResource AccentColor}"
                        VerticalAlignment="Center">

                    <TextBlock Text="▤"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#003F39"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- タイトル -->
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <TextBlock Text="発注管理"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="White"/>

                    <TextBlock Text="発注情報の検索・一覧・登録・更新・非表示管理"
                               FontSize="11"
                               Foreground="#B2DFDB"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 右上の説明 -->
                <TextBlock Grid.Column="2"
                           Text="[直接検索 / 即時反映]"
                           Foreground="White"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="10,0,16,0"/>
            </Grid>
        </Border>

        <!-- ====================================== -->
        <!-- 検索条件 -->
        <!-- ====================================== -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#CBD5E1"
                BorderThickness="1"
                CornerRadius="7"
                Margin="16,12,16,6"
                Padding="14,12">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 検索項目 -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="145"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="135"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="発注番号:"
                               Style="{StaticResource SearchLabelStyle}"/>

                    <TextBox x:Name="txt_MainOrderId"
                             Grid.Column="1"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Margin="0,0,12,0"
                             KeyDown="SearchField_KeyDown"/>

                    <TextBlock Grid.Column="2"
                               Text="仕入先名:"
                               Style="{StaticResource SearchLabelStyle}"/>

                    <TextBox x:Name="txt_MainSupplierName"
                             Grid.Column="3"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Margin="0,0,12,0"
                             KeyDown="SearchField_KeyDown"/>

                    <TextBlock Grid.Column="4"
                               Text="発注状態:"
                               Style="{StaticResource SearchLabelStyle}"/>

                    <ComboBox x:Name="cmb_MainOrderStatus"
                              Grid.Column="5"
                              Style="{StaticResource SearchComboBoxStyle}"
                              Margin="0,0,12,0"
                              ToolTip="発注状態で絞り込み"/>

                    <TextBlock Grid.Column="6"
                               Text="発注日:"
                               Style="{StaticResource SearchLabelStyle}"/>

                    <DatePicker x:Name="dp_MainOrderDate"
                                Grid.Column="7"
                                Style="{StaticResource EditDatePickerStyle}"
                                Margin="0,0,12,0"
                                ToolTip="発注日で絞り込み"/>
                </Grid>

                <!-- 検索操作 -->
                <Grid Grid.Row="1"
                      Margin="0,10,0,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="chk_MainIncludeHidden"
                              Grid.Column="0"
                              Content="非表示を含む"
                              Foreground="#243B5A"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Click="chk_MainIncludeHidden_Click"/>

                    <Button x:Name="btn_MainSearch"
                            Grid.Column="1"
                            Content="⌕  検索"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="btn_MainSearch_Click"
                            Margin="0,0,8,0"
                            MinWidth="90"/>

                    <Button x:Name="btn_MainClear"
                            Grid.Column="2"
                            Content="×  条件クリア"
                            Style="{StaticResource ClearButtonStyle}"
                            Click="btn_MainClear_Click"
                            Margin="0"
                            MinWidth="110"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ====================================== -->
        <!-- 操作ボタン・件数 -->
        <!-- ====================================== -->
        <Border Grid.Row="2"
                Background="#F1F5F9"
                BorderBrush="#C9D5E4"
                BorderThickness="0,0,0,1"
                Padding="16,5">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- 新規発注登録：常に青緑色 -->
                    <Button x:Name="btn_MainNewRegister"
                            Content="＋ 新規発注登録"
                            Style="{StaticResource RegisterButtonStyle}"
                            Click="btn_MainNewRegister_Click"/>

                    <!-- 編集：未選択時は薄い青 -->
                    <Button x:Name="btn_MainEditSelected"
                            Content="✎ 選択項目を編集"
                            Style="{StaticResource EditButtonStyle}"
                            Click="btn_MainEditSelected_Click"/>

                    <!-- 非表示：未選択時は薄い赤 -->
                    <Button x:Name="btn_MainHideSelected"
                            Content="⊘ 非表示設定"
                            Style="{StaticResource HideButtonStyle}"
                            Click="btn_MainHideSelected_Click"
                            Margin="0"/>
                </StackPanel>

                <!-- 表示件数 -->
                <TextBlock x:Name="txt_MainOrderCount"
                           Grid.Column="1"
                           Text="表示件数：0 件"
                           Foreground="#334E68"
                           FontWeight="SemiBold"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ====================================== -->
        <!-- 発注一覧 -->
        <!-- ====================================== -->
        <Border Grid.Row="3"
                Background="#F0F0F0"
                BorderBrush="#C9D5E4"
                BorderThickness="1"
                CornerRadius="5"
                Margin="16,0,16,16"
                Padding="0">

            <DataGrid x:Name="dg_MainOrders"
                      Style="{StaticResource PurchaseDataGridStyle}"
                      SelectionChanged="dg_MainOrders_SelectionChanged"
                      MouseDoubleClick="dg_MainOrders_MouseDoubleClick">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="発注番号"
                                        Binding="{Binding OrderId}"
                                        Width="150"/>

                    <DataGridTextColumn Header="仕入先名"
                                        Binding="{Binding SupplierName}"
                                        Width="*"
                                        MinWidth="180"/>

                    <DataGridTextColumn Header="発注日"
                                        Binding="{Binding OrderDate, StringFormat={}{0:yyyy/MM/dd}}"
                                        Width="150"/>

                    <DataGridTextColumn Header="合計金額"
                                        Binding="{Binding TotalAmount, StringFormat={}{0:N0} 円}"
                                        Width="170"/>

                    <DataGridTextColumn Header="発注状態"
                                        Binding="{Binding OrderStatus}"
                                        Width="150"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ====================================== -->
        <!-- 登録・編集ダイアログ -->
        <!-- ====================================== -->
        <Grid x:Name="modal_OrderEdit"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              Panel.ZIndex="100"
              Background="#80000000"
              MouseLeftButtonDown="modal_OrderEdit_Backdrop_MouseLeftButtonDown">

            <Border Width="500"
                    MaxHeight="600"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="EditDialog_MouseLeftButtonDown">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ダイアログタイトル -->
                    <Border Grid.Row="0"
                            Background="{StaticResource HeaderColor}"
                            CornerRadius="5"
                            Padding="14,12"
                            Margin="0,0,0,20">

                        <TextBlock x:Name="txt_EditTitle"
                                   Text="発注登録"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                    </Border>

                    <!-- 仕入先名 -->
                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,15">

                        <TextBlock Text="仕入先名"
                                   Style="{StaticResource SearchLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="txt_EditSupplierName"
                                 Style="{StaticResource SearchTextBoxStyle}"/>
                    </StackPanel>

                    <!-- 発注日 -->
                    <StackPanel Grid.Row="2"
                                Margin="0,0,0,15">

                        <TextBlock Text="発注日"
                                   Style="{StaticResource SearchLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <DatePicker x:Name="dp_EditOrderDate"
                                    Style="{StaticResource EditDatePickerStyle}"/>
                    </StackPanel>

                    <!-- 合計金額 -->
                    <StackPanel Grid.Row="3"
                                Margin="0,0,0,15">

                        <TextBlock Text="合計金額（円）"
                                   Style="{StaticResource SearchLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <TextBox x:Name="txt_EditTotalAmount"
                                 Style="{StaticResource SearchTextBoxStyle}"/>
                    </StackPanel>

                    <!-- 発注状態 -->
                    <StackPanel Grid.Row="4"
                                Margin="0,0,0,15">

                        <TextBlock Text="発注状態"
                                   Style="{StaticResource SearchLabelStyle}"
                                   Margin="0,0,0,6"/>

                        <ComboBox x:Name="cmb_EditOrderStatus"
                                  Style="{StaticResource SearchComboBoxStyle}"/>
                    </StackPanel>

                    <!-- エラー表示 -->
                    <TextBlock x:Name="txt_EditError"
                               Grid.Row="5"
                               Foreground="#DC2626"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <!-- ダイアログボタン -->
                    <StackPanel Grid.Row="6"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,8,0,0">

                        <Button x:Name="btn_EditCancel"
                                Content="キャンセル"
                                Style="{StaticResource ClearButtonStyle}"
                                Click="btn_EditCancel_Click"
                                Margin="0,0,8,0"/>

                        <Button x:Name="btn_EditSave"
                                Content="登録"
                                Style="{StaticResource RegisterButtonStyle}"
                                Click="btn_EditSave_Click"
                                Margin="0"
                                MinWidth="100"/>
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>