<Window x:Class="SalesManagement_SysDev.F_login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="販売管理システム - ログイン"
        Width="580" Height="740"
        MinWidth="500" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Meiryo, 'Yu Gothic UI'"
        Background="#F1F5F9">

    <Window.Resources>
        <!-- Blue Primary Button Style -->
        <Style x:Key="PrimaryLoginButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1877F2" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#166FE5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#125ECD" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="btnBorder" Property="Background" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Text Link Button Style -->
        <Style x:Key="SubtleLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#64748B" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#1877F2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Outer Centered Layout Container -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">

                <!-- Main Card -->
                <Border Width="450"
                        Background="#FFFFFF"
                        CornerRadius="16"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        Padding="36,36,36,36">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="24" ShadowDepth="4" Direction="270" />
                    </Border.Effect>

                    <StackPanel>

                        <!-- ============================================== -->
                        <!-- 1. NORMAL LOGIN VIEW PANEL                     -->
                        <!-- ============================================== -->
                        <StackPanel x:Name="panel_Login" Visibility="Visible">
                            <!-- Top Avatar Icon -->
                            <Viewbox Width="64" Height="64" Margin="0,0,0,16" HorizontalAlignment="Center">
                                <Canvas Width="64" Height="64">
                                    <!-- Avatar Head -->
                                    <Ellipse Width="24" Height="24" Canvas.Left="20" Canvas.Top="6" Fill="#1877F2" />
                                    <!-- Avatar Shoulders / Torso -->
                                    <Path Fill="#1877F2"
                                          Data="M 16,56 C 16,42 22,36 32,36 C 42,36 48,42 48,56 C 48,58 46,58 44,58 L 20,58 C 18,58 16,58 16,56 Z" />
                                </Canvas>
                            </Viewbox>

                            <!-- Title: ログイン -->
                            <TextBlock Text="ログイン"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                            <!-- Subtitle: 社員IDとパスワードを入力してログインしてください。 -->
                            <TextBlock Text="社員IDとパスワードを入力してログインしてください。"
                                       FontSize="13.5"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,0,0,24" />

                            <!-- Error Alert Banner -->
                            <Border x:Name="border_ErrorAlert"
                                    Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,18"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Fill="#DC2626" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                                    <TextBlock x:Name="txt_ErrorMessage"
                                               Text="社員IDまたはパスワードが正しくありません"
                                               Foreground="#B91C1C"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Field 1: 社員ID -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="社員ID"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"
                                           Margin="0,0,0,8" />

                                <Border x:Name="border_Id"
                                        Height="46"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Person Icon -->
                                        <Path Grid.Column="0"
                                              Fill="#94A3B8"
                                              Width="17" Height="17"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />

                                        <!-- Placeholder Text -->
                                        <TextBlock x:Name="watermark_Id"
                                                   Grid.Column="1"
                                                   Text="社員IDを入力"
                                                   FontSize="14"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Margin="0,0,10,0" />

                                        <!-- TextBox -->
                                        <TextBox x:Name="txt_EmployeeId"
                                                 Grid.Column="1"
                                                 FontSize="14"
                                                 Foreground="#1E293B"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0,0,10,0"
                                                 TextChanged="txt_EmployeeId_TextChanged"
                                                 GotFocus="txt_EmployeeId_GotFocus"
                                                 LostFocus="txt_EmployeeId_LostFocus" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Field 2: パスワード -->
                            <StackPanel Margin="0,0,0,28">
                                <TextBlock Text="パスワード"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"
                                           Margin="0,0,0,8" />

                                <Border x:Name="border_Password"
                                        Height="46"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Lock Icon -->
                                        <Path Grid.Column="0"
                                              Fill="#94A3B8"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />

                                        <!-- Placeholder Text -->
                                        <TextBlock x:Name="watermark_Password"
                                                   Grid.Column="1"
                                                   Text="パスワードを入力"
                                                   FontSize="14"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Margin="0,0,10,0" />

                                        <!-- PasswordBox (Masked) -->
                                        <PasswordBox x:Name="txt_Password"
                                                     Grid.Column="1"
                                                     FontSize="14"
                                                     Foreground="#1E293B"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalContentAlignment="Center"
                                                     Padding="0,0,10,0"
                                                     PasswordChanged="txt_Password_PasswordChanged"
                                                     GotFocus="txt_Password_GotFocus"
                                                     LostFocus="txt_Password_LostFocus" />

                                        <!-- TextBox (Revealed Plaintext) -->
                                        <TextBox x:Name="txt_PasswordRevealed"
                                                 Grid.Column="1"
                                                 FontSize="14"
                                                 Foreground="#1E293B"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0,0,10,0"
                                                 Visibility="Collapsed"
                                                 TextChanged="txt_PasswordRevealed_TextChanged"
                                                 GotFocus="txt_PasswordRevealed_GotFocus"
                                                 LostFocus="txt_PasswordRevealed_LostFocus" />

                                        <!-- Eye Icon Toggle Button -->
                                        <Button x:Name="btn_TogglePasswordVisibility"
                                                Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Focusable="False"
                                                Click="btn_TogglePasswordVisibility_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <Path x:Name="icon_Eye"
                                                              Fill="#94A3B8"
                                                              Width="18" Height="18"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="icon_Eye" Property="Fill" Value="#1877F2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Login Button: ログイン -->
                            <Button x:Name="btn_Login"
                                    Content="ログイン"
                                    Style="{StaticResource PrimaryLoginButtonStyle}"
                                    IsDefault="True"
                                    Click="btn_Login_Click" />

                            <!-- Forgot Password Link -->
                            <Button x:Name="btn_ForgotPasswordLink"
                                    Content="パスワードをお忘れですか？"
                                    Style="{StaticResource SubtleLinkButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"
                                    Click="btn_ForgotPasswordLink_Click" />
                        </StackPanel>

                        <!-- ============================================== -->
                        <!-- 2. FORGOT / RESET PASSWORD PANEL               -->
                        <!-- ============================================== -->
                        <StackPanel x:Name="panel_ResetPassword" Visibility="Collapsed">
                            <!-- Top Key / Lock Icon -->
                            <Viewbox Width="56" Height="56" Margin="0,0,0,14" HorizontalAlignment="Center">
                                <Canvas Width="64" Height="64">
                                    <Border Width="56" Height="56" Canvas.Left="4" Canvas.Top="4" Background="#EFF6FF" CornerRadius="28" />
                                    <Path Fill="#1877F2" Canvas.Left="16" Canvas.Top="14" Width="32" Height="32" Stretch="Uniform"
                                          Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                                </Canvas>
                            </Viewbox>

                            <!-- Title -->
                            <TextBlock Text="パスワード再設定"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#1E293B"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,6" />

                            <!-- Subtitle / Notice -->
                            <TextBlock x:Name="txt_ResetSubtitle"
                                       Text="社員IDと新しいパスワードを入力してください。"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20" />

                            <!-- Alert Box for Reset View -->
                            <Border x:Name="border_ResetAlert"
                                    Background="#FEF2F2"
                                    BorderBrush="#FECACA"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,16"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Fill="#DC2626" Width="16" Height="16" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                                          Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                                    <TextBlock x:Name="txt_ResetAlertMessage"
                                               Text="社員IDを入力してください。"
                                               Foreground="#B91C1C"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Field: 社員ID -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="社員ID"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="#1E293B"
                                           Margin="0,0,0,8" />

                                <Border x:Name="border_ResetId"
                                        Height="46"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Person Icon -->
                                        <Path Grid.Column="0"
                                              Fill="#94A3B8"
                                              Width="17" Height="17"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" />

                                        <TextBlock x:Name="watermark_ResetId"
                                                   Grid.Column="1"
                                                   Text="社員IDを入力"
                                                   FontSize="14"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Margin="0,0,10,0" />

                                        <TextBox x:Name="txt_ResetEmployeeId"
                                                 Grid.Column="1"
                                                 FontSize="14"
                                                 Foreground="#1E293B"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0,0,10,0"
                                                 TextChanged="txt_ResetEmployeeId_TextChanged"
                                                 GotFocus="txt_ResetEmployeeId_GotFocus"
                                                 LostFocus="txt_ResetEmployeeId_LostFocus" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Field: 新しいパスワード (As in screenshot 2) -->
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <Path Fill="#0052CC" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                          Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                                    <TextBlock Text="新しいパスワード"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#0A2540" />
                                </StackPanel>

                                <Border x:Name="border_NewPassword"
                                        Height="46"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Lock Icon -->
                                        <Path Grid.Column="0"
                                              Fill="#94A3B8"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />

                                        <!-- Placeholder Text -->
                                        <TextBlock x:Name="watermark_NewPassword"
                                                   Grid.Column="1"
                                                   Text="新しいパスワードを入力"
                                                   FontSize="14"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Margin="0,0,10,0" />

                                        <!-- PasswordBox -->
                                        <PasswordBox x:Name="txt_NewPassword"
                                                     Grid.Column="1"
                                                     FontSize="14"
                                                     Foreground="#1E293B"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalContentAlignment="Center"
                                                     Padding="0,0,10,0"
                                                     PasswordChanged="txt_NewPassword_PasswordChanged"
                                                     GotFocus="txt_NewPassword_GotFocus"
                                                     LostFocus="txt_NewPassword_LostFocus" />

                                        <!-- TextBox (Revealed) -->
                                        <TextBox x:Name="txt_NewPasswordRevealed"
                                                 Grid.Column="1"
                                                 FontSize="14"
                                                 Foreground="#1E293B"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0,0,10,0"
                                                 Visibility="Collapsed"
                                                 TextChanged="txt_NewPasswordRevealed_TextChanged"
                                                 GotFocus="txt_NewPasswordRevealed_GotFocus"
                                                 LostFocus="txt_NewPasswordRevealed_LostFocus" />

                                        <!-- Eye Icon Toggle -->
                                        <Button x:Name="btn_ToggleNewPasswordVisibility"
                                                Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Focusable="False"
                                                Click="btn_ToggleNewPasswordVisibility_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <Path x:Name="icon_NewEye"
                                                              Fill="#94A3B8"
                                                              Width="18" Height="18"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="icon_NewEye" Property="Fill" Value="#1877F2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Field: 新しいパスワード (確認用) (As in screenshot 2) -->
                            <StackPanel Margin="0,0,0,24">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                                    <Path Fill="#0052CC" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"
                                          Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />
                                    <TextBlock Text="新しいパスワード (確認用)"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="#0A2540" />
                                </StackPanel>

                                <Border x:Name="border_ConfirmPassword"
                                        Height="46"
                                        Background="#FFFFFF"
                                        BorderBrush="#CBD5E1"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="44" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Lock Icon -->
                                        <Path Grid.Column="0"
                                              Fill="#94A3B8"
                                              Width="16" Height="16"
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Data="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z" />

                                        <!-- Placeholder Text -->
                                        <TextBlock x:Name="watermark_ConfirmPassword"
                                                   Grid.Column="1"
                                                   Text="新しいパスワードを再入力"
                                                   FontSize="14"
                                                   Foreground="#94A3B8"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Margin="0,0,10,0" />

                                        <!-- PasswordBox -->
                                        <PasswordBox x:Name="txt_ConfirmPassword"
                                                     Grid.Column="1"
                                                     FontSize="14"
                                                     Foreground="#1E293B"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     VerticalContentAlignment="Center"
                                                     Padding="0,0,10,0"
                                                     PasswordChanged="txt_ConfirmPassword_PasswordChanged"
                                                     GotFocus="txt_ConfirmPassword_GotFocus"
                                                     LostFocus="txt_ConfirmPassword_LostFocus" />

                                        <!-- TextBox (Revealed) -->
                                        <TextBox x:Name="txt_ConfirmPasswordRevealed"
                                                 Grid.Column="1"
                                                 FontSize="14"
                                                 Foreground="#1E293B"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 VerticalContentAlignment="Center"
                                                 Padding="0,0,10,0"
                                                 Visibility="Collapsed"
                                                 TextChanged="txt_ConfirmPasswordRevealed_TextChanged"
                                                 GotFocus="txt_ConfirmPasswordRevealed_GotFocus"
                                                 LostFocus="txt_ConfirmPasswordRevealed_LostFocus" />

                                        <!-- Eye Icon Toggle -->
                                        <Button x:Name="btn_ToggleConfirmPasswordVisibility"
                                                Grid.Column="2"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Focusable="False"
                                                Click="btn_ToggleConfirmPasswordVisibility_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <Path x:Name="icon_ConfirmEye"
                                                              Fill="#94A3B8"
                                                              Width="18" Height="18"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Data="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zm0 12.5c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="icon_ConfirmEye" Property="Fill" Value="#1877F2" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Update Password Button -->
                            <Button x:Name="btn_ResetPasswordSubmit"
                                    Content="パスワードを変更してログイン"
                                    Style="{StaticResource PrimaryLoginButtonStyle}"
                                    Click="btn_ResetPasswordSubmit_Click" />

                            <!-- Back to Login Link -->
                            <Button x:Name="btn_BackToLogin"
                                    Content="← ログイン画面に戻る"
                                    Style="{StaticResource SubtleLinkButtonStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,18,0,0"
                                    Click="btn_BackToLogin_Click" />
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
