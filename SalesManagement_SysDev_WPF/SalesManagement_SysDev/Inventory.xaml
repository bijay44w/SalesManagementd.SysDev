<UserControl x:Class="SalesManagement_SysDev.Inventory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8FD"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="14">

    <UserControl.Resources>
        <Style x:Key="InventoryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A"
                                      Opacity="0.04"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4F8FD" Offset="0"/>
                <GradientStop Color="#ECF2FB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="36,30,36,18">

            <Border Background="#DBEAFE"
                    Width="54"
                    Height="54"
                    CornerRadius="27"
                    Margin="0,0,16,0">
                <Path Fill="#2563EB"
                      Width="26"
                      Height="26"
                      Stretch="Uniform"
                      Data="M3 5h18v3H3z M3 10h18v3H3z M3 15h18v3H3z"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="在庫管理"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="商品の在庫数や在庫情報を管理します。"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 操作カード：3列×2行 -->
        <Grid Grid.Row="1" Margin="26,0,36,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 在庫登録 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource InventoryCardStyle}"
                    MouseLeftButtonUp="card_InventoryRegister_MouseLeftButtonUp">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="+"
                                       FontSize="28"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="在庫登録" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="商品の在庫情報を入力し、&#x0a;登録します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 在庫更新 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource InventoryCardStyle}"
                    MouseLeftButtonUp="card_InventoryUpdate_MouseLeftButtonUp">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="✎" FontSize="23"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="在庫更新" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="登録済みの在庫情報を確認し、&#x0a;内容を更新します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 在庫一覧 -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource InventoryCardStyle}"
                    MouseLeftButtonUp="card_InventoryList_MouseLeftButtonUp">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="☷" FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="在庫一覧表示" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="登録されている在庫情報を&#x0a;一覧で表示します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 在庫検索 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource InventoryCardStyle}"
                    MouseLeftButtonUp="card_InventorySearch_MouseLeftButtonUp">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⌕" FontSize="30"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="在庫検索" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="商品コードや商品名などで検索し、&#x0a;在庫情報を表示します。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 在庫非表示 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource InventoryCardStyle}"
                    MouseLeftButtonUp="card_InventoryHide_MouseLeftButtonUp">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF" Width="44" Height="44"
                                CornerRadius="22" HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⊘" FontSize="25"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="在庫非表示" FontSize="17.5"
                                   FontWeight="Bold" Foreground="#0F172A"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="対象の在庫情報を管理フラグで&#x0a;非表示にします。"
                                   FontSize="12" Foreground="#64748B"
                                   LineHeight="19" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#EFF6FF" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20" Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 6枚目は空欄 -->
            <Grid Grid.Row="1" Grid.Column="2"/>

        </Grid>
    </Grid>
</UserControl>
