<UserControl x:Class="SalesManagement_SysDev.Inventory"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RetroTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#006666" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#F1F5F9" />
            <Setter Property="Foreground" Value="#334155" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="#DC2626" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: タイトル -->
            <RowDefinition Height="Auto" />
            <!-- 1: 検索条件バー -->
            <RowDefinition Height="Auto" />
            <!-- 2: 操作ツールバー -->
            <RowDefinition Height="Auto" />
            <!-- 3: 一覧表 DataGrid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. タイトルバー                                           -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#004D40" Padding="20,12" BorderBrush="#00332C" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26A69A" Width="34" Height="34" CornerRadius="4" Margin="0,0,12,0">
                        <TextBlock Text="🏬" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="在庫管理" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="在庫情報の検索・一覧・追加・在庫数変更・非表示管理" FontSize="11" Foreground="#80CBC4" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="【直接検索 / 即時反映】" FontSize="12" Foreground="#E0F2F1" VerticalAlignment="Center" Margin="0,0,10,0" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 1. 検索バー (常駐・即時検索)                              -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,12,16,8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- 在庫ID -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="在庫ID:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_MainStId" Style="{StaticResource RetroTextBoxStyle}" Width="70" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 商品名 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="商品名:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_MainPrName" Style="{StaticResource RetroTextBoxStyle}" Width="140" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- メーカー -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="メーカー:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="cmb_MainMaker" Width="130" Height="30" VerticalContentAlignment="Center" DisplayMemberPath="MaName" SelectedValuePath="MaId" />
                    </StackPanel>

                    <!-- 安全在庫割れのみ -->
                    <CheckBox x:Name="chk_MainBelowSafety" Content="⚠️ 安全在庫不足のみ" VerticalAlignment="Center" Margin="6,4,16,4" Foreground="#DC2626" FontWeight="SemiBold" Click="chk_Filter_Click" />

                    <!-- 非表示を含む -->
                    <CheckBox x:Name="chk_MainIncludeHidden" Content="非表示を含む" VerticalAlignment="Center" Margin="6,4,16,4" Foreground="#334155" FontWeight="SemiBold" Click="chk_Filter_Click" />
                </WrapPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btn_MainSearch" Style="{StaticResource ActionButtonStyle}" Background="#006666" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_MainSearch_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0" />
                            <TextBlock Text="検索" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_MainClear" Style="{StaticResource ActionButtonStyle}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Click="btn_MainClear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,4,0" />
                            <TextBlock Text="条件クリア" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. 操作ツールバー                                         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btn_MainNewRegister" Style="{StaticResource ActionButtonStyle}" Background="#008080" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_MainNewRegister_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,4,0" FontWeight="Bold" />
                        <TextBlock Text="新規在庫登録" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_MainEditSelected" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_MainEditSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✎" Margin="0,0,4,0" />
                        <TextBlock Text="在庫数を変更" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_MainHideSelected" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_MainHideSelected_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" Margin="0,0,4,0" />
                        <TextBlock Text="非表示設定" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="txt_MainStockCount" Grid.Column="1" Text="表示件数: 0 件" FontSize="13" Foreground="#475569" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. メイン DataGrid                                        -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,0,16,16">
            <DataGrid x:Name="dg_MainStocks"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="34"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      SelectionChanged="dg_MainStocks_SelectionChanged"
                      MouseDoubleClick="dg_MainStocks_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E2E8F0" />
                        <Setter Property="Foreground" Value="#1E293B" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="34" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="在庫ID" Binding="{Binding StId}" Width="70" />
                    <DataGridTextColumn Header="商品ID" Binding="{Binding PrId}" Width="70" />
                    <DataGridTextColumn Header="商品名" Binding="{Binding PrName}" Width="180" />
                    <DataGridTextColumn Header="メーカー" Binding="{Binding MaName}" Width="120" />
                    <DataGridTextColumn Header="小分類" Binding="{Binding ScName}" Width="110" />
                    <DataGridTextColumn Header="型番" Binding="{Binding PrModelNumber}" Width="110" />
                    <DataGridTextColumn Header="色" Binding="{Binding PrColor}" Width="80" />
                    <DataGridTextColumn Header="定価" Binding="{Binding PriceFormatted}" Width="95" />
                    <DataGridTextColumn Header="安全在庫" Binding="{Binding PrSafetyStock}" Width="80" />
                    <DataGridTextColumn Header="現在在庫数" Binding="{Binding QuantityFormatted}" Width="95" />
                    <DataGridTextColumn Header="判定" Binding="{Binding StockStatus}" Width="90" />
                    <DataGridTextColumn Header="状態" Binding="{Binding FlagFormatted}" Width="80" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- モーダル定義 (在庫登録, 在庫更新, 在庫非表示) -->
<Grid x:Name="modal_InventoryRegister" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_InventoryRegister_Backdrop_MouseLeftButtonDown" />
            <Border Width="560" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="30" ShadowDepth="8" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="+" FontSize="24" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="在庫登録" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                                <TextBlock Text="商品を選択して在庫数を設定・追加します。" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseInventoryRegister_Click">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- アラートバナー -->
                    <Border x:Name="border_RegErrorAlert" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_RegErrorMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="border_RegSuccessAlert" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_RegSuccessMessage" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- 商品選択 -->
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="対象商品 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <ComboBox x:Name="reg_cmb_Product" Height="36" VerticalContentAlignment="Center" DisplayMemberPath="PrName" SelectedValuePath="PrId" SelectionChanged="reg_cmb_Product_SelectionChanged" />
                    </StackPanel>

                    <!-- 商品詳細プレビュー -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="メーカー / 分類" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="reg_txt_ProductInfo" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="安全在庫数" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="reg_txt_SafetyStock" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 在庫数 -->
                    <StackPanel Margin="0,0,0,18">
                        <TextBlock Text="初期在庫数 / 追加在庫数 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="reg_txt_Quantity" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="6" Text="0" />
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btn_CloseInventoryRegister_Click" />
                        <Button Grid.Column="1" Content="在庫を登録" Style="{StaticResource PrimaryButtonStyle}" Click="btn_ExecuteInventoryRegister_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 5.1 モーダル: 在庫更新                                            -->
        <!-- ================================================================= -->

<Grid x:Name="modal_InventoryUpdate" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_InventoryUpdate_Backdrop_MouseLeftButtonDown" />
            <Border Width="560" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="30" ShadowDepth="8" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#EFF6FF" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="✎" FontSize="20" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="5.1 在庫更新" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                                <TextBlock Text="在庫テーブルにある商品情報を更新します。" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseInventoryUpdate_Click">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- 在庫ID検索バー -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="対象在庫ID:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="upd_txt_SearchStId" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" KeyUp="upd_txt_SearchStId_KeyUp" />
                            <Button Grid.Column="2" Content="情報呼び出し" Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="8,0,0,0" Click="btn_LoadStockForUpdate_Click" />
                        </Grid>
                    </Border>

                    <!-- アラートバナー -->
                    <Border x:Name="border_UpdErrorAlert" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_UpdErrorMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="border_UpdSuccessAlert" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_UpdSuccessMessage" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- 商品情報プレビュー -->
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="商品名" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="upd_txt_DisplayPrName" Text="-" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="メーカー / 分類" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="upd_txt_DisplayMaker" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="安全在庫数" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="upd_txt_DisplaySafetyStock" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="現在在庫数" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="upd_txt_DisplayCurrentQty" Text="-" FontSize="14" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 更新フォーム: 新しい在庫数 & フラグ -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="更新後の在庫数 *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <TextBox x:Name="upd_txt_Quantity" Height="36" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" MaxLength="6" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="在庫管理フラグ *" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <ComboBox x:Name="upd_cmb_StFlag" Height="36" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="0: 通常表示中" Tag="0" />
                                <ComboBoxItem Content="2: 非表示" Tag="2" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="閉じる" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btn_CloseInventoryUpdate_Click" />
                        <Button Grid.Column="1" Content="在庫数を更新" Style="{StaticResource PrimaryButtonStyle}" Click="btn_ExecuteInventoryUpdate_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================================================================= -->
        <!-- 5.2 モーダル: 在庫一覧表示                                        -->
        <!-- ================================================================= -->

<Grid x:Name="modal_InventoryHide" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_InventoryHide_Backdrop_MouseLeftButtonDown" />
            <Border Width="560" Background="#FFFFFF" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="30" ShadowDepth="8" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEE2E2" CornerRadius="10" Width="40" Height="40" Margin="0,0,12,0">
                                <TextBlock Text="⊘" FontSize="22" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="5.4 在庫非表示 (フラグ)" FontSize="18" FontWeight="Bold" Foreground="#1E293B" />
                                <TextBlock Text="選択された項目の在庫管理フラグを 0 から 2 に更新します。" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="32" Height="32" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseInventoryHide_Click">
                            <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <!-- 対象在庫ID呼び出し -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="対象在庫ID:" FontSize="13" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Grid.Column="1" x:Name="hide_txt_StId" Height="34" Padding="8,0" VerticalContentAlignment="Center" BorderBrush="#CBD5E1" KeyUp="hide_txt_StId_KeyUp" />
                            <Button Grid.Column="2" Content="情報呼び出し" Style="{StaticResource PrimaryButtonStyle}" Height="34" Margin="8,0,0,0" Click="btn_LoadStockForHide_Click" />
                        </Grid>
                    </Border>

                    <!-- アラートバナー -->
                    <Border x:Name="border_HideErrorAlert" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_HideErrorMessage" Foreground="#B91C1C" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>
                    <Border x:Name="border_HideSuccessAlert" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <TextBlock x:Name="txt_HideSuccessMessage" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <!-- 対象在庫情報プレビュー -->
                    <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="商品名" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayPrName" Text="-" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1">
                                <TextBlock Text="メーカー / 分類" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayMaker" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="現在在庫数" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayQty" Text="-" FontSize="13" FontWeight="SemiBold" Foreground="#334155" Margin="0,2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1">
                                <TextBlock Text="現在の管理フラグ" FontSize="11" Foreground="#64748B" />
                                <TextBlock x:Name="hide_txt_DisplayFlag" Text="-" FontSize="13" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="キャンセル" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="btn_CloseInventoryHide_Click" />
                        <Button Grid.Column="1" Content="管理フラグを 2 (非表示) に更新" Style="{StaticResource DangerButtonStyle}" Click="btn_ExecuteInventoryHide_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
