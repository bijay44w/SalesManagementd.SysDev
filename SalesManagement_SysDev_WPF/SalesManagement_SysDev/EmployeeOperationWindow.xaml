<Window x:Class="SalesManagement_SysDev.EmployeeOperationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="社員管理"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="#F4F8FD"
        FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
        FontSize="14">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText"
                       Text="社員一覧表示"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#0F172A"/>
            <TextBlock x:Name="DescriptionText"
                       Text="登録されている社員情報を一覧で表示します。"
                       Margin="0,5,0,0"
                       Foreground="#64748B"/>
        </StackPanel>

        <Grid x:Name="SearchPanel" Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchTextBox"
                     Grid.Column="0"
                     Height="38"
                     Padding="10,7"
                     VerticalContentAlignment="Center"
                     ToolTip="社員番号・氏名・営業所・役職・電話番号で検索"
                     KeyDown="SearchTextBox_KeyDown"/>
            <Button Grid.Column="1"
                    Content="検索"
                    Width="90"
                    Height="38"
                    Margin="8,0,0,0"
                    Click="SearchButton_Click"
                    Background="#2563EB"
                    Foreground="White"
                    BorderThickness="0"/>
            <Button Grid.Column="2"
                    Content="全件表示"
                    Width="100"
                    Height="38"
                    Margin="8,0,0,0"
                    Click="ClearSearchButton_Click"/>
        </Grid>

        <DataGrid x:Name="EmployeeDataGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  Background="White"
                  BorderBrush="#DCE4EF"
                  RowBackground="White"
                  AlternatingRowBackground="#F8FAFC"
                  SelectionChanged="EmployeeDataGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="社員番号" Binding="{Binding EmployeeId}" Width="90"/>
                <DataGridTextColumn Header="社員名" Binding="{Binding EmployeeName}" Width="*"/>
                <DataGridTextColumn Header="営業所" Binding="{Binding SalesOfficeName}" Width="150"/>
                <DataGridTextColumn Header="役職" Binding="{Binding PositionName}" Width="130"/>
                <DataGridTextColumn Header="入社日" Binding="{Binding HireDate, StringFormat={}{0:yyyy/MM/dd}}" Width="120"/>
                <DataGridTextColumn Header="電話番号" Binding="{Binding Phone}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border x:Name="EditPanel"
                Grid.Row="3"
                Margin="0,14,0,0"
                Padding="16"
                Background="White"
                BorderBrush="#DCE4EF"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="社員番号" VerticalAlignment="Center" Margin="0,0,8,10"/>
                <TextBox x:Name="EmployeeIdTextBox" Grid.Row="0" Grid.Column="1" Height="34" Margin="0,0,12,10" Padding="8,5" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="社員名" VerticalAlignment="Center" Margin="0,0,8,10"/>
                <TextBox x:Name="EmployeeNameTextBox" Grid.Row="0" Grid.Column="3" Height="34" Margin="0,0,12,10" Padding="8,5" VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="営業所" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="SalesOfficeComboBox" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,0,12,0" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="SalesOfficeId"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="役職" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="PositionComboBox" Grid.Row="1" Grid.Column="3" Height="34" Margin="0,0,12,0" VerticalContentAlignment="Center" DisplayMemberPath="DisplayName" SelectedValuePath="PositionId"/>

                <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="入社日" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <DatePicker x:Name="HireDatePicker" Grid.Column="1" Height="34" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="電話番号" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="PhoneTextBox" Grid.Column="3" Height="34" Padding="8,5" VerticalContentAlignment="Center"/>
                </Grid>

                <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="パスワード" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <PasswordBox x:Name="PasswordBox" Grid.Column="1" Height="34" Padding="8,5" VerticalContentAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="入力条件" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                    <TextBlock Grid.Column="3" Text="4～10文字" VerticalAlignment="Center" Foreground="#64748B"/>
                </Grid>

                <Button x:Name="ActionButton"
                        Grid.Row="0" Grid.Column="4" Grid.RowSpan="4"
                        Content="登録"
                        Width="140"
                        Height="40"
                        Margin="4,0,0,0"
                        VerticalAlignment="Center"
                        Click="ActionButton_Click"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</Window>
