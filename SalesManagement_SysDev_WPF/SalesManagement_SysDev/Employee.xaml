<UserControl x:Class="SalesManagement_SysDev.Employee"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8FD"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="14">

    <UserControl.Resources>
        <Style x:Key="EmployeeCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A"
                                      Opacity="0.04"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4F8FD" Offset="0"/>
                <GradientStop Color="#ECF2FB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="36,30,36,18">

            <Border Background="#DBEAFE"
                    Width="54"
                    Height="54"
                    CornerRadius="27"
                    Margin="0,0,16,0">
                <Path Fill="#2563EB"
                      Width="26"
                      Height="26"
                      Stretch="Uniform"
                      Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5s-3 1.34-3 3 1.34 3 3 3z M8 11c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5 5 6.34 5 8s1.34 3 3 3z M8 13c-2.33 0-7 1.17-7 3.5V19h14v-2.5C15 14.17 10.33 13 8 13z M16 13c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="社員管理"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="社員情報の登録・更新・検索などを管理します。"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- 操作カード：3列×2行 -->
        <Grid Grid.Row="1" Margin="26,0,36,30">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 社員登録 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource EmployeeCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="+"
                                       FontSize="28"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="社員登録"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="社員情報を入力し、&#x0a;登録します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 社員更新 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource EmployeeCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="✎"
                                       FontSize="23"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="社員更新"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="登録済みの社員情報を確認し、&#x0a;内容を更新します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 社員一覧表示 -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource EmployeeCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="☷"
                                       FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="社員一覧表示"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="登録されている社員情報を&#x0a;一覧で表示します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 社員検索 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource EmployeeCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⌕"
                                       FontSize="30"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="社員検索"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="社員番号や社員名などで検索し、&#x0a;社員情報を表示します。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 社員非表示 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource EmployeeCardStyle}">
                <Grid>
                    <StackPanel>
                        <Border Background="#EFF6FF"
                                Width="44" Height="44"
                                CornerRadius="22"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,14">
                            <TextBlock Text="⊘"
                                       FontSize="25"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="社員非表示"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="対象の社員情報を管理フラグで&#x0a;非表示にします。"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Width="36" Height="36"
                            CornerRadius="18"
                            Background="#EFF6FF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→" FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 6枚目は空欄 -->
            <Grid Grid.Row="1" Grid.Column="2"/>

        </Grid>
    </Grid>
</UserControl>
