<UserControl x:Class="SalesManagement_SysDev.Shipment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F5F9"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="13">

    <UserControl.Resources>
        <!-- レトロ・業務アプリ ボタンスタイル -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RetroTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: ヘッダー -->
            <RowDefinition Height="Auto" />
            <!-- 1: 検索条件バー -->
            <RowDefinition Height="Auto" />
            <!-- 2: 操作ツールバー -->
            <RowDefinition Height="Auto" />
            <!-- 3: 一覧表 DataGrid -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======================================================== -->
        <!-- 0. タイトルバー (Retro Dark Teal)                         -->
        <!-- ======================================================== -->
        <Border Grid.Row="0" Background="#004D40" Padding="20,12" BorderBrush="#00332C" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#26A69A" Width="34" Height="34" CornerRadius="4" Margin="0,0,12,0">
                        <TextBlock Text="🚚" FontSize="18" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="出荷管理" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="出荷情報の検索・一覧・登録・詳細確認・確定・非表示管理" FontSize="11" Foreground="#80CBC4" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="【直接検索 / 即時反映】" FontSize="12" Foreground="#E0F2F1" VerticalAlignment="Center" Margin="0,0,10,0" />
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 1. 検索バー (画面上部に常駐・モーダル不要)                 -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,12,16,8" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 検索フィールド群 -->
                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- 出荷ID -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="出荷ID:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchShId" Style="{StaticResource RetroTextBoxStyle}" Width="70" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 受注ID -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="受注ID:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchOrId" Style="{StaticResource RetroTextBoxStyle}" Width="70" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 顧客名 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="顧客名:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchClName" Style="{StaticResource RetroTextBoxStyle}" Width="120" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 営業所 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="営業所:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="cmb_SearchOffice" Width="130" Height="30" VerticalContentAlignment="Center" DisplayMemberPath="SoName" SelectedValuePath="SoId" SelectionChanged="cmb_Filter_SelectionChanged" />
                    </StackPanel>

                    <!-- 担当社員 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="担当社員:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="txt_SearchEmName" Style="{StaticResource RetroTextBoxStyle}" Width="100" KeyDown="SearchField_KeyDown" />
                    </StackPanel>

                    <!-- 確定状態 -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,16,4" VerticalAlignment="Center">
                        <TextBlock Text="状態:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="cmb_SearchState" Width="100" Height="30" VerticalContentAlignment="Center" SelectionChanged="cmb_Filter_SelectionChanged">
                            <ComboBoxItem Content="すべて" IsSelected="True" />
                            <ComboBoxItem Content="未確定" Tag="0" />
                            <ComboBoxItem Content="確定済" Tag="1" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 出荷完了日 From〜To -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,8,4" VerticalAlignment="Center">
                        <TextBlock Text="完了日:" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <DatePicker x:Name="dp_SearchDateFrom" Width="115" Height="30" SelectedDateChanged="dp_Filter_SelectedDateChanged" />
                        <TextBlock Text="〜" VerticalAlignment="Center" Margin="4,0,4,0" />
                        <DatePicker x:Name="dp_SearchDateTo" Width="115" Height="30" SelectedDateChanged="dp_Filter_SelectedDateChanged" />
                    </StackPanel>

                    <!-- 非表示を含む -->
                    <CheckBox x:Name="chk_IncludeHidden" Content="非表示を含む" VerticalAlignment="Center" Margin="6,4,16,4" Foreground="#334155" FontWeight="SemiBold" Click="chk_IncludeHidden_Click" />
                </WrapPanel>

                <!-- 検索・クリアボタン (右寄せ) -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                    <Button x:Name="btn_Search" Style="{StaticResource ActionButtonStyle}" Background="#006666" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" Margin="0,0,4,0" />
                            <TextBlock Text="検索" FontWeight="Bold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="btn_Clear" Style="{StaticResource ActionButtonStyle}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Click="btn_Clear_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✕" Margin="0,0,4,0" />
                            <TextBlock Text="条件クリア" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ======================================================== -->
        <!-- 2. 操作ツールバー                                         -->
        <!-- ======================================================== -->
        <Grid Grid.Row="2" Margin="16,0,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="btn_OpenRegister" Style="{StaticResource ActionButtonStyle}" Background="#006666" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_OpenRegister_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋" Margin="0,0,4,0" FontWeight="Bold" />
                        <TextBlock Text="新規出荷登録" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_OpenDetail" Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Margin="0,0,8,0" Click="btn_OpenDetail_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" Margin="0,0,4,0" />
                        <TextBlock Text="出荷詳細" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_OpenHide" Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Click="btn_OpenHide_Click" IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⊘" Margin="0,0,4,0" />
                        <TextBlock Text="非表示設定" FontWeight="Bold" />
                    </StackPanel>
                </Button>

                <Button x:Name="btn_OpenDelete" Style="{StaticResource ActionButtonStyle}" Background="#991B1B" Foreground="#FFFFFF" Margin="8,0,0,0" Click="btn_OpenDelete_Click" IsEnabled="False" Width="109">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑" Margin="0,0,4,0" />
                        <TextBlock Text="削除" FontWeight="Bold" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- レコード件数表示 -->
            <TextBlock x:Name="txt_RecordCount" Grid.Column="1" Text="表示件数: 0 件" FontSize="13" Foreground="#475569" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- ======================================================== -->
        <!-- 3. メイン DataGrid (出荷一覧)                             -->
        <!-- ======================================================== -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Margin="16,0,16,16">
            <DataGrid x:Name="dg_Shipments"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E2E8F0"
                      RowHeight="34"
                      AlternatingRowBackground="#F8FAFC"
                      BorderThickness="0"
                      SelectionChanged="dg_Shipments_SelectionChanged"
                      MouseDoubleClick="dg_Shipments_MouseDoubleClick">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#E2E8F0" />
                        <Setter Property="Foreground" Value="#1E293B" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Height" Value="32" />
                        <Setter Property="Padding" Value="10,0" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="BorderBrush" Value="#CBD5E1" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="出荷ID" Binding="{Binding ShId}" Width="65" />
                    <DataGridTextColumn Header="受注ID" Binding="{Binding OrId}" Width="65" />
                    <DataGridTextColumn Header="顧客名" Binding="{Binding ClName}" Width="150" />
                    <DataGridTextColumn Header="所属営業所" Binding="{Binding SoName}" Width="120" />
                    <DataGridTextColumn Header="担当社員" Binding="{Binding EmName}" Width="110" />
                    <DataGridTextColumn Header="完了日" Binding="{Binding ShFinishDateFormatted}" Width="100" />
                    <DataGridTextColumn Header="品目数" Binding="{Binding DetailCount, StringFormat={}{0} 品目}" Width="80" />
                    <DataGridTextColumn Header="合計数量" Binding="{Binding TotalQuantity, StringFormat={}{0} 個}" Width="85" />
                    <DataGridTextColumn Header="状態" Binding="{Binding StateFormatted}" Width="80" />
                    <DataGridTextColumn Header="管理" Binding="{Binding FlagFormatted}" Width="75" />
                    <DataGridTextColumn Header="非表示理由 / 備考" Binding="{Binding ShHidden}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ======================================================== -->
        <!-- モーダル 1: 出荷登録                                      -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_Register" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_Register_Backdrop_Click" />
            <Border Width="640" MaxHeight="680" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="25" ShadowDepth="6" Direction="270" />
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ヘッダー -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#E0F2F1" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                    <TextBlock Text="＋" FontSize="20" Foreground="#004D40" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="新規出荷登録" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                                    <TextBlock Text="受注情報を選択し、出荷指示データを登録します。" FontSize="11" Foreground="#64748B" />
                                </StackPanel>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CancelRegister_Click">
                                <TextBlock Text="✕" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <Separator Background="#E2E8F0" Margin="0,0,0,14" />

                        <!-- 対象受注選択 -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="対象受注 *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                            <ComboBox x:Name="reg_cmb_Order" Height="34" VerticalContentAlignment="Center" SelectionChanged="reg_cmb_Order_SelectionChanged" />
                        </StackPanel>

                        <!-- 受注付随情報（自動補完） -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="顧客名" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox x:Name="reg_txt_Client" Style="{StaticResource RetroTextBoxStyle}" IsReadOnly="True" Background="#F8FAFC" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="営業所" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <TextBox x:Name="reg_txt_Office" Style="{StaticResource RetroTextBoxStyle}" IsReadOnly="True" Background="#F8FAFC" />
                            </StackPanel>
                        </Grid>

                        <!-- 担当社員 ＆ 完了予定日 -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                <TextBlock Text="担当社員" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <ComboBox x:Name="reg_cmb_Employee" Height="32" VerticalContentAlignment="Center" DisplayMemberPath="EmName" SelectedValuePath="EmId" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="出荷日" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                                <DatePicker x:Name="reg_dp_FinishDate" Height="32" VerticalContentAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <!-- 受注明細プレビュー -->
                        <TextBlock Text="出荷対象商品一覧（受注明細より自動抽出）" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16" MaxHeight="180">
                            <DataGrid x:Name="reg_dg_Details" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" RowHeight="28" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品ID" Binding="{Binding PrId}" Width="60" />
                                    <DataGridTextColumn Header="商品名" Binding="{Binding PrName}" Width="*" />
                                    <DataGridTextColumn Header="出荷数量" Binding="{Binding ShQuantity}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- ボタン群 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActionButtonStyle}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,8,0" Click="btn_CancelRegister_Click" Content="キャンセル" />
                            <Button Style="{StaticResource ActionButtonStyle}" Background="#006666" Foreground="#FFFFFF" Click="btn_ExecuteRegister_Click" Content="出荷指示を登録" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- モーダル 2: 出荷詳細・確定                                -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_Detail" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_Detail_Backdrop_Click" />
            <Border Width="620" MaxHeight="650" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="25" ShadowDepth="6" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <!-- ヘッダー -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#E0F2FE" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="🔍" FontSize="16" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="detail_txt_HeaderTitle" Text="出荷詳細情報" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="出荷指示内容の確認および出荷確定処理を行います。" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CloseDetail_Click">
                            <TextBlock Text="✕" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Separator Background="#E2E8F0" Margin="0,0,0,14" />

                    <!-- ヘッダー情報サマリー -->
                    <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Name="detail_txt_ShId" Text="出荷ID: -" FontWeight="Bold" Foreground="#1E293B" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="detail_txt_Client" Text="顧客: -" FontWeight="Bold" Foreground="#1E293B" />

                            <TextBlock Grid.Row="2" Grid.Column="0" x:Name="detail_txt_Office" Text="営業所: -" Foreground="#475569" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="detail_txt_State" Text="確定状態: -" Foreground="#475569" />
                        </Grid>
                    </Border>

                    <!-- 出荷明細一覧 -->
                    <TextBlock Text="出荷商品明細" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                    <Border Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Margin="0,0,0,16" MaxHeight="220">
                        <DataGrid x:Name="detail_dg_Items"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  RowHeight="28"
                                  AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#E2E8F0" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Height" Value="28" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="出荷明細ID" Binding="{Binding ShDetailId}" Width="85" />
                                <DataGridTextColumn Header="出荷ID" Binding="{Binding ShId}" Width="70" />
                                <DataGridTextColumn Header="商品ID" Binding="{Binding PrId}" Width="70" />
                                <DataGridTextColumn Header="商品名" Binding="{Binding PrName}" Width="*" />
                                <DataGridTextColumn Header="数量" Binding="{Binding ShQuantity}" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- ボタン -->
                    <Grid>
                        <Button x:Name="btn_ConfirmShipment" HorizontalAlignment="Left" Style="{StaticResource ActionButtonStyle}" Background="#16A34A" Foreground="#FFFFFF" Click="btn_ConfirmShipment_Click" Content="✔ 出荷を確定する（在庫減算）" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource ActionButtonStyle}" Background="#0284C7" Foreground="#FFFFFF" Click="btn_CloseDetail_Click" Content="閉じる" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ======================================================== -->
        <!-- モーダル 3: 出荷非表示設定 (論理削除)                      -->
        <!-- ======================================================== -->
        <Grid x:Name="modal_Hide" Grid.RowSpan="4" Visibility="Collapsed" Panel.ZIndex="1000">
            <Border Background="#66000000" MouseLeftButtonDown="modal_Hide_Backdrop_Click" />
            <Border Width="460" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.18" BlurRadius="25" ShadowDepth="6" Direction="270" />
                </Border.Effect>
                <StackPanel>
                    <!-- ヘッダー -->
                    <Grid Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#FEF2F2" CornerRadius="8" Width="36" Height="36" Margin="0,0,10,0">
                                <TextBlock Text="⊘" FontSize="18" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="出荷非表示設定" FontSize="17" FontWeight="Bold" Foreground="#0F172A" />
                                <TextBlock Text="対象の出荷情報を非表示（論理削除）にします。" FontSize="11" Foreground="#64748B" />
                            </StackPanel>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Width="28" Height="28" Background="#F1F5F9" BorderThickness="0" Cursor="Hand" Click="btn_CancelHide_Click">
                            <TextBlock Text="✕" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>

                    <Separator Background="#E2E8F0" Margin="0,0,0,14" />

                    <!-- 対象確認情報 -->
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="hide_txt_TargetInfo" Text="出荷ID: - / 顧客: -" FontWeight="Bold" Foreground="#1E293B" FontSize="13.5" />
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="0,0,0,16">
                        <TextBlock Text="非表示理由" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4" />
                        <TextBox x:Name="hide_txt_Reason" Style="{StaticResource RetroTextBoxStyle}" Text="出荷取消による非表示設定" />
                    </StackPanel>

                    <!-- ボタン群 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ActionButtonStyle}" Background="#F1F5F9" Foreground="#334155" BorderBrush="#94A3B8" BorderThickness="1" Margin="0,0,8,0" Click="btn_CancelHide_Click" Content="キャンセル" />
                        <Button Style="{StaticResource ActionButtonStyle}" Background="#DC2626" Foreground="#FFFFFF" Click="btn_ExecuteHide_Click" Content="非表示にする" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
