<UserControl x:Class="SalesManagement_SysDev.Shipment"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F8FD"
             FontFamily="Segoe UI, Meiryo, Yu Gothic UI"
             FontSize="14">

    <UserControl.Resources>
        <Style x:Key="ShipmentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24,22"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A"
                                      Opacity="0.04"
                                      BlurRadius="20"
                                      ShadowDepth="4"
                                      Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F4F8FD" Offset="0"/>
                <GradientStop Color="#ECF2FB" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="36,30,36,18">

            <Border Width="54"
                    Height="54"
                    Background="#DBEAFE"
                    CornerRadius="27"
                    Margin="0,0,16,0">
                <Viewbox Width="26" Height="26">
                    <Path Fill="#2563EB"
                          Data="M4 4h16v3H4z M4 9h16v3H4z M4 14h10v3H4z"/>
                </Viewbox>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="出荷管理"
                           FontSize="25"
                           FontWeight="Bold"
                           Foreground="#0F172A"/>

                <TextBlock Text="出荷情報の登録・更新・検索を管理します"
                           FontSize="13"
                           Foreground="#64748B"
                           Margin="0,5,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- メニューカード -->
        <Grid Grid.Row="1" Margin="26,0,36,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 出荷登録 -->
            <Border Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource ShipmentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="44" Height="44"
                                Background="#EFF6FF"
                                CornerRadius="22"
                                Margin="0,0,0,14">
                            <TextBlock Text="＋"
                                       FontSize="25"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="出荷登録"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="新しい出荷情報を登録します"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Width="36" Height="36"
                            Background="#EFF6FF"
                            CornerRadius="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 出荷更新 -->
            <Border Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource ShipmentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="44" Height="44"
                                Background="#EFF6FF"
                                CornerRadius="22"
                                Margin="0,0,0,14">
                            <TextBlock Text="✎"
                                       FontSize="23"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="出荷更新"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="登録済みの出荷情報を更新します"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Width="36" Height="36"
                            Background="#EFF6FF"
                            CornerRadius="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 出荷一覧表示 -->
            <Border Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource ShipmentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="44" Height="44"
                                Background="#EFF6FF"
                                CornerRadius="22"
                                Margin="0,0,0,14">
                            <TextBlock Text="▤"
                                       FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="出荷一覧表示"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="登録されている出荷情報を一覧で表示します"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Width="36" Height="36"
                            Background="#EFF6FF"
                            CornerRadius="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 出荷検索 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource ShipmentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="44" Height="44"
                                Background="#EFF6FF"
                                CornerRadius="22"
                                Margin="0,0,0,14">
                            <TextBlock Text="⌕"
                                       FontSize="30"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="出荷検索"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="条件を指定して出荷情報を検索します"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Width="36" Height="36"
                            Background="#EFF6FF"
                            CornerRadius="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- 出荷非表示 -->
            <Border Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource ShipmentCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Width="44" Height="44"
                                Background="#EFF6FF"
                                CornerRadius="22"
                                Margin="0,0,0,14">
                            <TextBlock Text="◉"
                                       FontSize="24"
                                       Foreground="#2563EB"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <TextBlock Text="出荷非表示"
                                   FontSize="17.5"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="対象の出荷情報を一覧から非表示にします"
                                   FontSize="12"
                                   Foreground="#64748B"
                                   LineHeight="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Width="36" Height="36"
                            Background="#EFF6FF"
                            CornerRadius="18"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom">
                        <TextBlock Text="→"
                                   FontSize="20"
                                   Foreground="#2563EB"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>